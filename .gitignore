# ---------------------------------------------------------------------------
# Secrets and credentials (never commit; templates stay tracked)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
docker/.secrets/
.secrets/
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
credentials.json
service-account*.json
*.tfstate
*.tfvars
# Private keys only. The CA certificates in backend/tools/certs/ are public
# trust anchors the crawler needs, so they stay tracked.
*.pem
!backend/tools/certs/*.pem

# ---------------------------------------------------------------------------
# Dependencies (matches nested workspaces and replica backends too)
# ---------------------------------------------------------------------------
node_modules/
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# Local databases: SQLite files are regenerated by the seed scripts
# ---------------------------------------------------------------------------
*.sqlite
*.sqlite-shm
*.sqlite-wal
# The archived databases in backup/ are deliberate and stay tracked
!backup/**/*.sqlite

# ---------------------------------------------------------------------------
# Generated test and comparison output
# ---------------------------------------------------------------------------
tests/e2e/e2e-report.json
backend/gov_replica/*/*/comparison/
backend/gov_replica/*/*/replica_screenshots/

# ---------------------------------------------------------------------------
# Logs, caches and temp files
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
.cache/
.tmp/
tmp/
.eslintcache
coverage/
.nyc_output/
*.swp
# Crawler HTTP cache inside each replica's logs/ (regenerated by the crawl)
.asset-cache/

# PostgreSQL migration logs (only the folder placeholder is tracked)
database/postgres/logs/*
!database/postgres/logs/.gitkeep

# Docker test data
docker/.test-data/

# ---------------------------------------------------------------------------
# IDE and editor files
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.iml
.vs/
*.sublime-project
*.sublime-workspace

# ---------------------------------------------------------------------------
# OS files
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
