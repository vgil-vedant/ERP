<%- include('../partials/head') %>
<link rel="stylesheet" href="/static/css/custom.css">
<%- include('../partials/header') %>
<main id="main">
  <section class="ef-contact-stage">
    <div class="ef-contact-card">
      <p class="ef-contact-card__bar">Single sign-on</p>
      <div class="ef-contact-card__box">
        <h1 class="ef-contact-card__head">Login with JanParichay</h1>
        <div class="ef-contact-card__body">
          <p style="margin:0 0 12px">
            On the original this button sends you to the national JanParichay sign-in service.
            This replica never contacts that service and never signs anyone in through it.
          </p>
          <p style="margin:0">
            To try the local sign-in, use <a href="/Login">Login</a>. Nothing you type here is
            sent to any government system.
          </p>
        </div>
      </div>
    </div>
  </section>
</main>
<%- include('../partials/footer') %>
