<%
var _fu = {};
var _fnav = nav.map(function (item) {
  var label = String(item.label || '');
  if (item.href === '/') label = 'Home';
  else if (item.href === '/ecourtindia_v6') label = 'Services Home';
  else {
    label = label.replace(/\s*[-:|]\s*e-?Court.*$/i, '').trim() || label;
    if (/^home$/i.test(label)) label = 'Search by CNR';
  }
  _fu[label] = (_fu[label] || 0) + 1;
  if (_fu[label] > 1) label += ' (' + _fu[label] + ')';
  return { href: item.href, label: label };
});
%>
<footer class="site-footer">
  <div class="shell site-footer__cols">
    <div class="site-footer__col">
      <h2 class="site-footer__h">Useful links</h2>
      <ul class="footer-links">
        <% _fnav.slice(0, 8).forEach(function (item) { %>
          <li><a href="<%= item.href %>"><%= item.label %></a></li>
        <% }); %>
      </ul>
    </div>
    <div class="site-footer__col">
      <h2 class="site-footer__h">About this replica</h2>
      <address>
        Unofficial local demonstration of <code><%= site.hostname %></code>.<br>
        Placeholder details only &mdash; no real office is represented.<br>
        Not operated by any government body.
      </address>
    </div>
    <div class="site-footer__col">
      <h2 class="site-footer__h">Served from</h2>
      <address><%= typeof linkHost !== 'undefined' && linkHost ? linkHost : 'this local server' %><br>(local demonstration)</address>
    </div>
  </div>
  <div class="site-footer__bar">
    <div class="shell site-footer__bar-inner">
      <p>Unofficial local demonstration for development and testing.</p>
      <ul class="footer-legal">
        <li><a href="/__about">About this replica</a></li>
        <li><a href="/__gaps">What is not reproduced</a></li>
      </ul>
      <p class="footer-note">Replica of a public portal. Not affiliated with, endorsed by,
      or operated by any government agency.</p>
    </div>
  </div>
</footer>
<script src="/static/js/replica.js" defer></script>
</body>
</html>
