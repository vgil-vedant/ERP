<%
/* The home page's Services, Statistics and References sections. Titles, destinations, labels and file sizes come from
   page.home (captured from the original home page); the statistic values come from this page's own outline. */
var ICONS = {
  scales: '<path d="M12 3v18"/><path d="M5 7h14"/><path d="m5 7-3 7a3 3 0 0 0 6 0Z"/><path d="m19 7-3 7a3 3 0 0 0 6 0Z"/><path d="M8 21h8"/>',
  court: '<path d="M3 10 12 4l9 6"/><path d="M5 10v8M9.5 10v8M14.5 10v8M19 10v8"/><path d="M3 20h18"/>',
  rupee: '<path d="M6 3h12"/><path d="M6 8h12"/><path d="m6 13 8.5 8"/><path d="M6 13h3"/><path d="M9 13c6.667 0 6.667-10 0-10"/>',
  chart: '<path d="M3 3v18h18"/><path d="M8 17v-5"/><path d="M13 17V8"/><path d="M18 17v-9"/>',
  filepen: '<path d="M12 22h6a2 2 0 0 0 2-2V7l-5-5H6a2 2 0 0 0-2 2v10"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10.4 12.6a2 2 0 1 1 3 3L8 21l-4 1 1-4Z"/>',
  filesearch: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><circle cx="11.5" cy="14.5" r="2.5"/><path d="m13.3 16.3 2.2 2.2"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  book: '<path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2z"/><path d="M22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z"/>',
  hourglass: '<path d="M5 22h14M5 2h14"/><path d="M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22"/><path d="M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2"/>',
  check: '<circle cx="12" cy="12" r="9"/><path d="m8.5 12.5 2.5 2.5 4.5-5"/>',
  calendar: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
  download: '<path d="M12 3v12"/><path d="m7 11 5 5 5-5"/><path d="M5 21h14"/>'
};
var _svg = function (n) { return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + (ICONS[n] || '') + '</svg>'; };
var _home = page.home;
// statistic values, in order, from the outline entries under the "Statistics" heading
var _vals = [], _inStats = false;
(page.outline || []).forEach(function (o) {
  if (o.level === 2) { _inStats = /^Statistics$/i.test(o.text); return; }
  if (_inStats) _vals.push(o.text);
});
%>
<div class="home-sections">

  <section class="hs hs--stats" aria-labelledby="hs-stats-h">
    <div class="hs__wrap">
      <h2 class="hs__title" id="hs-stats-h">Statistics</h2>
      <div class="stats">
        <% if (_home.login) { %>
          <div class="stats__login">
            <p class="stats__login-label"><%= _home.login.label %></p>
            <span class="stats__login-btn" aria-disabled="true" title="Signing in with JanParichay is not available in this local demonstration">
              <img src="<%= _home.login.logo %>" alt="Jan Parichay logo" width="150" height="40">
            </span>
          </div>
        <% } %>
        <ul class="stats__grid">
          <% _home.statisticsLabels.forEach(function (s, i) { %>
            <li class="stat">
              <span class="stat__icon"><%- _svg(s.icon) %></span>
              <span class="stat__body">
                <strong class="stat__value"><%= _vals[i] != null ? _vals[i] : '—' %></strong>
                <span class="stat__label"><%= s.label %></span>
              </span>
            </li>
          <% }); %>
        </ul>
      </div>
    </div>
  </section>

  <section class="hs hs--services" aria-labelledby="hs-services-h">
    <div class="hs__wrap">
      <h2 class="hs__title" id="hs-services-h">Services</h2>
      <ul class="svc-grid">
        <% _home.services.forEach(function (s, i) { var tone = ((i % 4) + Math.floor(i / 4)) % 2 === 0 ? 'a' : 'b'; %>
          <li class="svc svc--<%= tone %>">
            <% if (s.route) { %>
              <a class="svc__link" href="<%= s.route %>" title="<%= s.text %>">
                <span class="svc__icon"><%- _svg(s.icon) %></span>
                <span class="svc__name"><%= s.title %></span>
                <span class="sr-only"><%= s.text %></span>
              </a>
            <% } else { %>
              <div class="svc__link is-off" title="<%= s.text %> (no page for this service in the demonstration)">
                <span class="svc__icon"><%- _svg(s.icon) %></span>
                <span class="svc__name"><%= s.title %></span>
                <span class="sr-only"><%= s.text %>. No page for this service in the demonstration.</span>
              </div>
            <% } %>
          </li>
        <% }); %>
      </ul>
    </div>
  </section>

  <section class="hs hs--refs" aria-labelledby="hs-refs-h">
    <div class="hs__wrap">
      <h2 class="hs__title" id="hs-refs-h">References</h2>
      <ul class="ref-grid">
        <% _home.references.forEach(function (r) { %>
          <li class="ref">
            <div class="ref__head"><span class="ref__badge"><img src="/static/img/pdf-icon.png" alt="" width="40" height="40"></span></div>
            <div class="ref__body">
              <h3 class="ref__title"><%= r.title %></h3>
              <p class="ref__size"><%= r.size %></p>
            </div>
            <% if (r.file) { %>
              <a class="ref__download" href="<%= r.file %>" download aria-label="Download <%= r.title %> (PDF, <%= r.size %>)"><%- _svg('download') %><span>Download</span></a>
            <% } else { %>
              <span class="ref__download is-off" aria-disabled="true" title="This document is not included in the local demonstration"><%- _svg('download') %><span>Not included</span></span>
            <% } %>
          </li>
        <% }); %>
      </ul>
    </div>
  </section>

</div>
