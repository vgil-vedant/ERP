<%
  const _navLabel = function (i) { return i.href === '/' ? 'Home' : i.href === '/feedback.htm' ? 'Feedback' : i.href === '/login.htm' ? 'Citizen Login' : i.label; };
%>
<header class="gh">
  <div class="gh-util"><div class="shell gh-util__in">
    <span class="gh-util__tag">Crime and Criminal Tracking Network &amp; Systems &middot; Citizen Services</span>
    <% if (typeof officeButton !== 'undefined' && officeButton) { %><a class="office-login" href="/office/login">Office login</a><% } else { %><span></span><% } %>
  </div></div>
  <div class="gh-brand"><div class="shell gh-brand__in">
    <a class="gh-logo" href="/">
      <img src="/static/img/cctns-mark.svg" alt="" width="45" height="52">
      <span class="gh-logo__t"><b>सीसीटीएनएस / CCTNS</b><small>Citizen Services &middot; Local demonstration</small></span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">
      <span class="nav-toggle__bar" aria-hidden="true"></span><span class="sr-only">Menu</span>
    </button>
  </div></div>
  <div class="gh-nav"><div class="shell">
    <nav id="primary-nav" class="primary-nav" aria-label="Primary">
      <ul class="primary-nav__list">
        <% nav.forEach(function (item) { %>
          <li><a class="primary-nav__link" href="<%= item.href %>"
                 <%= currentPath === item.href ? 'aria-current="page"' : '' %>><%= _navLabel(item) %></a></li>
        <% }); %>
      </ul>
    </nav>
  </div></div>
</header>
<% if (typeof pageTitle !== 'undefined' && pageTitle) { %>
  <div class="page-title-bar"><div class="page-title-bar__inner"><%= pageTitle === ':::CCTNS:::' ? 'CCTNS Citizen Services' : pageTitle %></div></div>
<% } %>

<% const _hv = (typeof page !== 'undefined' && page && page.visual) ? page.visual : null; %>
<% const _custom = (typeof isCustomView !== 'undefined') && isCustomView; %>
<% if (!_custom && _hv && _hv.heroBg && _hv.heroHeight >= 140) { %>
  <section class="hero-band <%= _hv.onDark ? 'hero-band--dark' : 'hero-band--light' %>"
           style="background: <%= _hv.heroBg %>; min-height: <%= _hv.heroHeight %>px">
    <div class="hero-band__inner">
      <p class="hero-band__lede"><%= (page.outline && page.outline[0]) ? page.outline[0].text : page.heading %></p>
      <p class="hero-band__sub">The original shows an illustrated hero here. Its artwork is
      government material and is not redistributed, so the replica reproduces the band and its
      measured height only.</p>
    </div>
  </section>
<% } %>
