<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main id="main"><div class="shell"><section class="section">
  <h1 class="section__title">Grievance <%= grievance.reference_no %></h1>
  <div class="notice notice--ok" role="status">
    Current status:
    <span class="status-chip" data-status="<%= grievance.status %>"><%= grievance.status.replace(/_/g,' ') %></span>
  </div>
  <dl class="kv">
    <dt>Reference</dt><dd><span class="ref-no"><%= grievance.reference_no %></span></dd>
    <dt>Complainant</dt><dd><%= grievance.complainant_name %> (<%= grievance.complainant_mobile %>)</dd>
    <dt>Relation to inmate</dt><dd><%= grievance.relationship_name || 'Not stated' %></dd>
    <dt>Inmate</dt><dd><%= grievance.inmate_name %></dd>
    <dt>State / Jail</dt><dd><%= grievance.state_name %> &mdash; <%= grievance.jail_name %></dd>
    <dt>Category</dt><dd><%= grievance.category || 'Not stated' %></dd>
    <dt>Subject</dt><dd><%= grievance.subject %></dd>
    <dt>Details</dt><dd><%= grievance.description %></dd>
    <dt>Received</dt><dd><%= grievance.created_at %></dd>
    <dt>Due</dt><dd><%= grievance.due_at || '—' %></dd>
    <dt>Disposed</dt><dd><%= grievance.disposed_at || 'Not yet disposed' %></dd>
  </dl>

  <h2 class="section__title" style="font-size:20px">Action trail</h2>
  <div class="table-wrap">
    <table class="data">
      <caption>Every action is timestamped and attributed, as the ERP scope requires.</caption>
      <thead><tr><th scope="col">Action</th><th scope="col">Remark</th><th scope="col">By</th><th scope="col">At</th></tr></thead>
      <tbody><% actions.forEach(function (a) { %>
        <tr><td><%= a.action %></td><td><%= a.remark || '—' %></td><td><%= a.actor_role %></td><td><%= a.acted_at %></td></tr>
      <% }); %></tbody>
    </table>
  </div>
  <p><a class="btn btn--secondary" href="/public/grievancelogin">Check another reference</a></p>
</section></div></main>
<%- include('../partials/footer') %>
