<%- include('../partials/head') %>
<%- include('../partials/header') %>

<%# The original's banner is a two-slide carousel; its two images are digital.jpg and ourservice.jpg. %>
<section class="carousel" aria-roledescription="carousel" aria-label="Portal highlights">
  <div class="carousel__viewport">
    <div class="carousel__slide is-active" role="group" aria-roledescription="slide" aria-label="1 of 2">
      <%- include('../partials/img/banner-digital', { cls: 'carousel__img' }) %>
    </div>
    <div class="carousel__slide" role="group" aria-roledescription="slide" aria-label="2 of 2">
      <%- include('../partials/img/banner-services', { cls: 'carousel__img' }) %>
    </div>
  </div>
  <button class="carousel__ctrl carousel__ctrl--prev" type="button" aria-label="Previous slide"><span aria-hidden="true">&#8249;</span></button>
  <button class="carousel__ctrl carousel__ctrl--next" type="button" aria-label="Next slide"><span aria-hidden="true">&#8250;</span></button>
  <div class="carousel__dots">
    <button type="button" class="is-active" aria-label="Slide 1" aria-current="true"></button>
    <button type="button" aria-label="Slide 2"></button>
  </div>
</section>
<script src="/static/js/home-carousel.js" defer></script>

<main id="main">
  <div class="shell">
    <section class="section">
      <h2 class="section__title">Features</h2>
      <div class="feature-grid">
        <% [
          ['IV','Instant Visit Request','Advance visit request to meet your wards.','/public/MyVisitRegistration','feature-1'],
          ['DR','Dashboard Reports','Statistical information about prison population, daily admissions, release, visits etc.','/public/DashBoard','feature-2'],
          ['PC','ePrison Canteen','Support the inmates by purchasing the items produced in prison factory.',null,'feature-3'],
          ['KI','KIOSK Information','Information access to inmates.',null,'feature-4'],
          ['GR','Grievances','Submit grievances of your wards lodged inside the prison online.','/public/grievance','feature-5'],
          ['LA','Legal Aid','Legal Aid Made Simple.','/Legalaid/Secure/Login','feature-6']
        ].forEach(function (f) { %>
          <div class="feature">
            <div class="feature__icon" aria-hidden="true"><%- include('../partials/img/' + f[4]) %></div>
            <div class="feature__body">
              <h3><% if (f[3]) { %><a href="<%= f[3] %>"><%= f[1] %></a><% } else { %><%= f[1] %><% } %></h3>
              <p><%= f[2] %></p>
            </div>
          </div>
        <% }); %>
      </div>
    </section>

    <section class="section">
      <h2 class="section__title">Highlights</h2>
      <p class="section__intro">Figures below are computed from the local demonstration
      database and are synthetic. They are not the original portal's statistics.</p>
      <div class="tile-grid">
        <div class="tile tile--purple">
          <span class="tile__badge" aria-hidden="true"><%- include('../partials/img/tile-states') %></span>
          <span class="tile__label">States Covered</span>
          <span class="tile__value"><%= stats.statesCovered.toLocaleString('en-IN') %></span>
        </div>
        <div class="tile tile--teal">
          <span class="tile__badge" aria-hidden="true"><%- include('../partials/img/tile-prisons') %></span>
          <span class="tile__label">Prisons On-Board</span>
          <span class="tile__value"><%= stats.prisonsOnBoard.toLocaleString('en-IN') %></span>
        </div>
        <div class="tile tile--blue">
          <span class="tile__badge" aria-hidden="true"><%- include('../partials/img/tile-records') %></span>
          <span class="tile__label">Demo Records Held</span>
          <span class="tile__value"><%= (stats.visitRequestsHeld + stats.grievancesHeld).toLocaleString('en-IN') %></span>
        </div>
      </div>
    </section>
  </div>
</main>

<%- include('../partials/footer') %>
