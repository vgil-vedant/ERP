<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main id="main"><div class="shell"><section class="section section--flush">
  <p class="section__intro">Synthetic figures from the local demonstration database.
  These are not the original portal's statistics.</p>
  <% const max = rows.reduce(function (m, r) { return Math.max(m, r.value); }, 0) || 1; %>
  <div class="table-wrap">
    <table class="data">
      <caption><%= rows.length %> states/UTs.</caption>
      <thead><tr>
        <th scope="col">State / UT</th>
        <th scope="col" class="num"><%= metricLabel %></th>
        <th scope="col">Relative</th>
      </tr></thead>
      <tbody>
        <% rows.forEach(function (r) { %>
          <tr>
            <th scope="row"><%= r.state_name %></th>
            <td class="num"><%= Number(r.value).toLocaleString('en-IN') %></td>
            <td>
              <span class="meter" role="img"
                    aria-label="<%= Math.round(r.value / max * 100) %> percent of the highest value">
                <span class="meter__fill" style="width: <%= Math.round(r.value / max * 100) %>%"></span>
              </span>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</section></div></main>
<%- include('../partials/footer') %>
