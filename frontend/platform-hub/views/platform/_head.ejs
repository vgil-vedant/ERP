<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %></title>
<style>
  :root{--ink:#111827;--muted:#5b6678;--line:#e2e7ef;--panel:#fff;--bg:#eef1f6;
        --accent:#1d4ed8;--err:#b42318;--ok:#047857;--chip:#eef2ff}
  *{box-sizing:border-box}
  body{margin:0;font:15px/1.55 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
       color:var(--ink);background:var(--bg)}
  .notice{background:#7f1d1d;color:#fff;padding:7px 16px;font-size:12.5px;text-align:center}
  .bar{background:#0f172a;color:#fff;padding:13px 18px;display:flex;gap:12px;
       align-items:baseline;flex-wrap:wrap}
  .bar strong{font-size:15px}
  .bar span{font-size:12.5px;color:#9fb0c9}
  .bar a{color:#cfe0ff;font-size:13px;text-decoration:none;margin-left:auto}
  .wrap{max-width:620px;margin:28px auto;padding:0 16px}
  .wide{max-width:980px}
  .panel{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:26px}
  h1{font-size:21px;margin:0 0 6px}
  .lede{color:var(--muted);font-size:13.5px;margin:0 0 22px}
  label{display:block;font-size:13px;font-weight:600;margin:16px 0 5px}
  .req{color:var(--err)}
  input{width:100%;padding:10px 12px;font-size:14.5px;border:1px solid #c7cedb;
        border-radius:7px;background:#fff;color:var(--ink)}
  input:focus{outline:2px solid var(--accent);outline-offset:1px;border-color:var(--accent)}
  .err{color:var(--err);font-size:12.5px;margin-top:4px}
  input.bad{border-color:var(--err)}
  .hint{color:var(--muted);font-size:12px;margin-top:4px}
  button{margin-top:22px;width:100%;padding:12px;font-size:15px;font-weight:600;
         background:var(--accent);color:#fff;border:0;border-radius:7px;cursor:pointer}
  button:hover{background:#1740b5}
  .alt{margin-top:18px;font-size:13.5px;color:var(--muted);text-align:center}
  .alt a{color:var(--accent)}
  .fatal{background:#fef2f2;border:1px solid #fca5a5;color:#7f1d1d;
         border-radius:8px;padding:13px 15px;font-size:13.5px;margin-bottom:20px}
  .good{background:#ecfdf5;border:1px solid #6ee7b7;color:#065f46;
        border-radius:8px;padding:13px 15px;font-size:13.5px;margin-bottom:20px}
  .portals{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px}
  .portals a{background:var(--chip);color:var(--accent);border-radius:20px;
             padding:4px 11px;font-size:12px;text-decoration:none;font-weight:600}
  .portals a.here{background:var(--accent);color:#fff}
  table{width:100%;border-collapse:collapse;font-size:13.5px;margin-top:8px}
  th{text-align:left;background:#f6f8fc;padding:9px 11px;font-size:11.5px;
     text-transform:uppercase;letter-spacing:.04em;color:var(--muted);border-bottom:1px solid var(--line)}
  td{padding:9px 11px;border-bottom:1px solid #f1f3f7;vertical-align:top}
  code{font:12.5px ui-monospace,Menlo,Consolas,monospace;background:#f1f3f7;padding:1px 5px;border-radius:4px}
  dl{display:grid;grid-template-columns:auto 1fr;gap:7px 16px;margin:0 0 20px;font-size:14px}
  dt{color:var(--muted);font-size:12.5px}
  dd{margin:0;font-weight:600}
  .logout{background:none;border:1px solid #c7cedb;color:var(--muted);
          width:auto;padding:7px 14px;font-size:13px;font-weight:500;margin:0}
  .logout:hover{background:#f1f3f7}
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){--ink:#e8ecf3;--muted:#92a0b5;--line:#2a3342;
      --panel:#161c27;--bg:#0c1118;--chip:#1e293b}
    :root:not([data-theme="light"]) input{background:#1b2230;border-color:#33405280;color:#e8ecf3}
    :root:not([data-theme="light"]) th{background:#1b2230}
    :root:not([data-theme="light"]) td{border-bottom-color:#232c3a}
    :root:not([data-theme="light"]) code{background:#232c3a}
    :root:not([data-theme="light"]) .fatal{background:#2a1416;border-color:#7f1d1d;color:#fecaca}
    :root:not([data-theme="light"]) .good{background:#0e2a20;border-color:#047857;color:#6ee7b7}
    :root:not([data-theme="light"]) .logout{border-color:#334052}
  }
</style>
</head>
<body>
<div class="notice">Unofficial Local Demonstration &mdash; Not an Official Government Service</div>
<div class="bar">
  <strong><%= site.name %></strong>
  <span><%= site.hostname %> &middot; replica</span>
  <a href="/">&larr; back to the portal</a>
</div>
