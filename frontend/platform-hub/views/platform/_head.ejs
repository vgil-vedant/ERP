<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %></title>
<style>
  :root{--ink:#292832;--muted:#6c6665;--line:#e9d8ce;--panel:#fff;--bg:#fcefe5;
        --accent:#f16f3f;--accent-ink:#a94e2c;--action:#f8a66b;--action-hover:#f39450;--action-active:#e9843c;--action-ink:#b04e1c;--err:#b42318;--ok:#047857;--chip:#f5e7df}
  *{box-sizing:border-box}
  body{margin:0;font:15px/1.55 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
       color:var(--ink);background:var(--bg)}
  .notice{background:#7f1d1d;color:#fff;padding:7px 16px;font-size:12.5px;text-align:center}
  .bar{background:#292832;color:#fff;padding:13px 18px;display:flex;gap:12px;
       align-items:baseline;flex-wrap:wrap}
  .bar strong{font-size:15px}
  .bar span{font-size:12.5px;color:#d9c9c0}
  .bar a{color:#f9c2a2;font-size:13px;text-decoration:none;margin-left:auto}
  .wrap{max-width:620px;margin:28px auto;padding:0 16px}
  .wide{max-width:980px}
  .panel{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:26px;
         box-shadow:0 1px 2px rgba(41,40,50,.04),0 10px 24px -20px rgba(41,40,50,.30)}
  h1{font-size:21px;margin:0 0 6px;color:var(--ink);font-weight:800}
  .lede{color:var(--muted);font-size:13.5px;margin:0 0 22px}
  label{display:block;font-size:13px;font-weight:600;margin:16px 0 5px}
  .req{color:var(--err)}
  input{width:100%;padding:10px 12px;font-size:14.5px;border:1px solid #d9c9c0;
        border-radius:7px;background:#fff;color:var(--ink)}
  input:focus{outline:none;border-color:var(--action-ink);box-shadow:0 0 0 3px rgba(240,140,80,.25)}
  input::placeholder{color:var(--muted);opacity:1}
  .err{color:var(--err);font-size:12.5px;margin-top:4px}
  input.bad{border-color:var(--err)}
  .hint{color:var(--muted);font-size:12px;margin-top:4px}
  button{margin-top:22px;width:100%;padding:12px;font-size:15px;font-weight:600;
         background:var(--action);color:#292832;border:0;border-radius:9px;cursor:pointer;
         box-shadow:0 8px 18px -12px rgba(240,140,80,.60);transition:background .16s,transform .08s}
  button:hover{background:var(--action-hover)}
  button:active{background:var(--action-active);transform:translateY(1px)}
  button:focus-visible{outline:2px solid var(--action-ink);outline-offset:2px}
  .alt{margin-top:18px;font-size:13.5px;color:var(--muted);text-align:center}
  .alt a{color:var(--action-ink)}
  .fatal{background:#fef2f2;border:1px solid #fca5a5;color:#7f1d1d;
         border-radius:8px;padding:13px 15px;font-size:13.5px;margin-bottom:20px}
  .good{background:#ecfdf5;border:1px solid #6ee7b7;color:#065f46;
        border-radius:8px;padding:13px 15px;font-size:13.5px;margin-bottom:20px}
  .portals{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px}
  .portals a{background:var(--chip);color:var(--accent-ink);border-radius:20px;
             padding:4px 11px;font-size:12px;text-decoration:none;font-weight:600}
  .portals a.here{background:var(--accent);color:var(--ink)}
  table{width:100%;border-collapse:collapse;font-size:13.5px;margin-top:8px}
  th{text-align:left;background:#faf3ef;padding:9px 11px;font-size:11.5px;
     text-transform:uppercase;letter-spacing:.04em;color:var(--muted);border-bottom:1px solid var(--line)}
  td{padding:9px 11px;border-bottom:1px solid #f4ebe6;vertical-align:top}
  code{font:12.5px ui-monospace,Menlo,Consolas,monospace;background:#f5e7df;padding:1px 5px;border-radius:4px}
  dl{display:grid;grid-template-columns:auto 1fr;gap:7px 16px;margin:0 0 20px;font-size:14px}
  dt{color:var(--muted);font-size:12.5px}
  dd{margin:0;font-weight:600}
  .logout{background:none;border:1px solid #d9c9c0;color:var(--muted);
          width:auto;padding:7px 14px;font-size:13px;font-weight:500;margin:0}
  .logout:hover{background:#f5e7df}
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){--accent-ink:#f58a50;--action-ink:#f8a66b;--ink:#fcefe5;--muted:#bdb4af;--line:#44434e;
      --panel:#33323c;--bg:#222129;--chip:#44434e}
    :root:not([data-theme="light"]) input{background:#2d2c35;border-color:#55545f80;color:#fcefe5}
    :root:not([data-theme="light"]) th{background:#2d2c35}
    :root:not([data-theme="light"]) td{border-bottom-color:#3d3c47}
    :root:not([data-theme="light"]) code{background:#3d3c47}
    :root:not([data-theme="light"]) .fatal{background:#2a1416;border-color:#7f1d1d;color:#fecaca}
    :root:not([data-theme="light"]) .good{background:#0e2a20;border-color:#047857;color:#6ee7b7}
    :root:not([data-theme="light"]) .logout{border-color:#55545f}
  }
</style>
</head>
<body>
<div class="notice">Unofficial Local Demonstration &mdash; Not an Official Government Service</div>
<div class="bar">
  <strong><%= site.name %></strong>
  <span><%= site.hostname %> &middot; replica</span>
  <a href="/">&larr; back to the portal</a>
</div>
