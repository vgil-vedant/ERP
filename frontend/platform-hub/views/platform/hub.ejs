<%- include('_shell-head') %>

<div class="page-head">
  <div>
    <h1 class="page-title">Dashboard</h1>
    <p class="page-desc">One backend and one database serve every portal below. A citizen registers once, and each submission is written here and mirrored to the ERP.</p>
  </div>
  <div class="page-actions">
    <button class="btn" type="button" onclick="exportTableCSV('hub-portals.csv')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0 4-4m-4 4-4-4"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
      Export CSV
    </button>
  </div>
</div>

<div class="g-kpi">
  <div class="card kpi">
    <div class="kpi-top"><span class="pill pill-mint">shared account</span></div>
    <div class="kpi-label">Registrations</div>
    <div class="kpi-value"><%= summary.people %></div>
    <div class="kpi-note">rows in the person table</div>
  </div>
  <div class="card kpi">
    <div class="kpi-top"><span class="pill pill-neutral">all portals</span></div>
    <div class="kpi-label">Submissions</div>
    <div class="kpi-value"><%= summary.submissions %></div>
    <div class="kpi-note">rows in the submission table</div>
  </div>
  <div class="card kpi">
    <div class="kpi-top"><span class="pill <%= summary.synced === summary.submissions ? 'pill-ok' : 'pill-warn' %>">write-through</span></div>
    <div class="kpi-label">Mirrored to the ERP</div>
    <div class="kpi-value"><%= summary.synced %></div>
    <div class="kpi-note"><%= summary.submissions - summary.synced %> not mirrored</div>
  </div>
  <div class="card kpi">
    <div class="kpi-top"><span class="pill pill-info">listeners</span></div>
    <div class="kpi-label">Portals</div>
    <div class="kpi-value"><%= sites.length %></div>
    <div class="kpi-note">served by one process (pid <%= pid %>)</div>
  </div>
</div>

<!-- ERP Hub Banner -->
<%
  var erpHost = process.env.ERP_HOST || '127.0.0.1';
  var erpPort = Number(process.env.ERP_PORT) || 4200;
  var erpURL  = 'http://' + erpHost + ':' + erpPort;
%>
<div style="margin-bottom:16px;padding:20px 24px;border-radius:16px;background:linear-gradient(130deg,#0F2D1E,#163A28);border:1px solid rgba(62,207,142,.18);display:flex;align-items:center;gap:20px;flex-wrap:wrap">
  <div style="flex:0 0 48px;width:48px;height:48px;border-radius:14px;background:rgba(62,207,142,.15);display:grid;place-items:center">
    <svg style="width:24px;height:24px;color:#3ECF8E" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="8" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="15" width="7" height="6" rx="1.5"/></svg>
  </div>
  <div style="flex:1;min-width:200px">
    <div style="font-size:15px;font-weight:800;color:#E8F8F1;letter-spacing:-.02em;margin-bottom:3px">ERP Hub Console</div>
    <div style="font-size:12px;color:#7DB8A0;line-height:1.4">Dashboard with live charts, government portal cards, sync activity ledger and integration status — all backed by real intake data.</div>
  </div>
  <div style="display:flex;gap:8px;flex-wrap:wrap">
    <a href="<%= erpURL %>/" target="_blank" rel="noopener"
       style="display:inline-flex;align-items:center;gap:6px;height:34px;padding:0 16px;border-radius:9px;background:#3ECF8E;color:#0A2018;font-size:12.5px;font-weight:800;text-decoration:none;white-space:nowrap">
      Open Console
      <svg style="width:13px;height:13px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="M15 3h6v6M10 14 21 3"/></svg>
    </a>
    <a href="<%= erpURL %>/portals" target="_blank" rel="noopener"
       style="display:inline-flex;align-items:center;gap:6px;height:34px;padding:0 14px;border-radius:9px;background:rgba(255,255,255,.08);color:#A5C9B8;font-size:12px;font-weight:700;text-decoration:none;border:1px solid rgba(255,255,255,.1);white-space:nowrap">
      Portals
    </a>
    <a href="<%= erpURL %>/sync" target="_blank" rel="noopener"
       style="display:inline-flex;align-items:center;gap:6px;height:34px;padding:0 14px;border-radius:9px;background:rgba(255,255,255,.08);color:#A5C9B8;font-size:12px;font-weight:700;text-decoration:none;border:1px solid rgba(255,255,255,.1);white-space:nowrap">
      Sync
    </a>
  </div>
</div>

<div class="grid g-ab" style="margin-bottom:16px">
  <div class="card">
    <div class="card-head">
      <div>
        <div class="card-title">Submissions by portal</div>
        <div class="card-sub">How many records each portal has collected, and how many reached the ERP.</div>
      </div>
      <span class="pill pill-mint">site</span>
    </div>
    <% if (!summary.submissions) { %>
      <div class="empty-state">
      <div class="empty-title">No submissions yet</div>
      <div class="empty-hint">Fill in a form on any portal and it will appear here.</div>
    </div>
    <% } else { %>
      <% var maxN = Math.max.apply(null, summary.bySite.map(function (b) { return b.n; })) || 1; %>
      <div class="bar-chart" style="padding:4px 20px 18px">
        <% summary.bySite.forEach(function (b) { %>
          <div class="bar-row">
            <div class="bar-label" title="<%= b.name %>"><%= b.name %></div>
            <div class="bar-track"><div class="bar-fill" style="width:<%= Math.round((b.n / maxN) * 100) %>%"></div></div>
            <div class="bar-val"><%= b.n %></div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <div class="card">
    <div class="card-head">
      <div>
        <div class="card-title">Backend</div>
        <div class="card-sub">Where this hub gets its data and where it sends it.</div>
      </div>
    </div>
    <div class="kv-list">
      <div class="kv-row"><div class="kv-key">Shared database</div><div class="kv-val"><code class="mono-chip"><%= dbPath %></code></div></div>
      <div class="kv-row"><div class="kv-key">ERP backend</div><div class="kv-val"><code class="mono-chip"><%= erpTarget %></code><br><span style="font-size:11.5px;color:var(--text-3)">reached over HTTP only</span></div></div>
      <div class="kv-row"><div class="kv-key">Process</div><div class="kv-val">pid <%= pid %></div></div>
    </div>
    <div class="card-foot">
      <span style="font-size:11.5px;color:var(--text-3)">JSON:
        <a href="/api/summary">summary</a> &middot; <a href="/api/people">people</a> &middot; <a href="/api/submissions">submissions</a> &middot; <a href="/api/sync">sync</a> &middot; <a href="/api/audit">audit</a>
      </span>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-head">
    <div>
      <div class="card-title">Portals</div>
      <div class="card-sub">Each portal keeps its own port. Links use the address you opened this hub with.</div>
    </div>
    <a href="/portals" class="btn btn-sm">View all &rarr;</a>
  </div>
  <div class="tbl-wrap">
    <table class="tbl" id="mainTable">
      <thead><tr><th>Logo</th><th data-sort>Portal</th><th data-sort>Host</th><th data-sort>Submissions</th><th data-sort>In the ERP</th><th>Open</th></tr></thead>
      <tbody>
        <% summary.bySite.forEach(function (b) {
             var s = sites.find(function (x) { return x.code === b.code; }) || {}; %>
          <tr>
            <td class="logo-cell"><span class="logo-tile"><img src="/logo/<%= b.code %>" alt="<%= b.name %> logo" loading="lazy"></span></td>
            <td><strong><%= b.name %></strong><br><code class="mono-chip"><%= b.code %></code></td>
            <td><%= s.hostname || '' %></td>
            <td><%= b.n %></td>
            <td><%= b.synced || 0 %></td>
            <td><a class="open-link" href="http://<%= typeof linkHost === 'undefined' ? '127.0.0.1' : linkHost %>:<%= s.port %>/" title="Open <%= b.name %> (:<%= s.port %>)" aria-label="Open <%= b.name %>"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6"/><path d="M20 4 10 14"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg></a></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('_shell-foot') %>
