<%- include('_auth-top') %>
  <div class="lg-portals-top">
    <p class="lg-hint">One account, <%= portals.length %> portals. A session here is a session on all of them.</p>
    <%- include('_portals') %>
  </div>
  <div class="lg-center">
    <h1>Create your account</h1>
    <p class="lg-sub">Register once and the same account is accepted by every portal in this demonstration.</p>

    <% if (fatal) { %><div class="lg-fatal" role="alert"><%= fatal %></div><% } %>

    <form method="post" action="/account/register<%= next ? '?next=' + encodeURIComponent(next) : '' %>" novalidate data-auth>
      <%- include('_auth-field', {id:'full_name', name:'full_name', label:'Full name', icon:'user',
            value: form.full_name || '', required:true, maxlength:80, autocomplete:'name', autofocus:true,
            empty:'Please enter your full name.', error: errors.full_name || ''}) %>
      <%- include('_auth-field', {id:'email', name:'email', type:'email', label:'Email', icon:'mail',
            value: form.email || '', required:true, maxlength:120, autocomplete:'email',
            empty:'Please enter your email.', error: errors.email || ''}) %>
      <%- include('_auth-field', {id:'mobile', name:'mobile', label:'Mobile (optional)', icon:'phone',
            value: form.mobile || '', maxlength:10, inputmode:'numeric', autocomplete:'tel',
            error: errors.mobile || ''}) %>
      <%- include('_auth-field', {id:'password', name:'password', type:'password', label:'Password', icon:'lock',
            pw:true, required:true, autocomplete:'new-password',
            empty:'Please enter a password.', error: errors.password || ''}) %>
      <%- include('_auth-field', {id:'confirm_password', name:'confirm_password', type:'password', label:'Confirm password', icon:'lock',
            pw:true, required:true, autocomplete:'new-password',
            empty:'Please confirm your password.', error: errors.confirm_password || ''}) %>

      <div class="lg-actions">
        <button class="lg-btn lg-btn-primary" type="submit">
          <span class="lg-bic"><%- include('_auth-icon', {n:'userplus'}) %></span><span class="lg-spin" aria-hidden="true"></span>
          <span class="lg-lbl" data-busy="Registering…">Register</span>
        </button>
        <a class="lg-btn lg-btn-outline" href="/account/login<%= next ? '?next=' + encodeURIComponent(next) : '' %>">
          <span class="lg-bic"><%- include('_auth-icon', {n:'login'}) %></span>
          <span class="lg-lbl">Sign in</span>
        </a>
      </div>
    </form>

  </div>
  <p class="lg-foot"><%= site.hostname %> &middot; replica</p>
<%- include('_auth-bottom') %>
