<%- include('_head') %>
<div class="wrap">
  <div class="panel">
    <h1><%= pageTitle %></h1>
    <p class="lede">
      Register once here and the same account is accepted by every portal in this
      demonstration. You will not be asked to register again on any of them.
    </p>

    <% if (fatal) { %><div class="fatal"><%= fatal %></div><% } %>

    <form method="post" action="/account/register<%= next ? '?next=' + encodeURIComponent(next) : '' %>" novalidate>
      <label for="full_name">Full name <span class="req">*</span></label>
      <input id="full_name" name="full_name" maxlength="80" required
             class="<%= errors.full_name ? 'bad' : '' %>" value="<%= form.full_name || '' %>">
      <% if (errors.full_name) { %><p class="err"><%= errors.full_name %></p><% } %>

      <label for="email">Email <span class="req">*</span></label>
      <input id="email" name="email" type="email" maxlength="120" required
             class="<%= errors.email ? 'bad' : '' %>" value="<%= form.email || '' %>">
      <% if (errors.email) { %><p class="err"><%= errors.email %></p><% } %>
      <p class="hint">Used as your sign-in name on all <%= portals.length %> portals.</p>

      <label for="mobile">Mobile</label>
      <input id="mobile" name="mobile" inputmode="numeric" maxlength="10"
             class="<%= errors.mobile ? 'bad' : '' %>" value="<%= form.mobile || '' %>">
      <% if (errors.mobile) { %><p class="err"><%= errors.mobile %></p><% } %>
      <p class="hint">Optional. 10 digits. Use a made-up number &mdash; this is a demonstration.</p>

      <label for="password">Password <span class="req">*</span></label>
      <input id="password" name="password" type="password" required
             class="<%= errors.password ? 'bad' : '' %>">
      <% if (errors.password) { %><p class="err"><%= errors.password %></p><% } %>
      <p class="hint">At least 8 characters. Stored only as a salted scrypt hash.</p>

      <label for="confirm_password">Confirm password <span class="req">*</span></label>
      <input id="confirm_password" name="confirm_password" type="password" required
             class="<%= errors.confirm_password ? 'bad' : '' %>">
      <% if (errors.confirm_password) { %><p class="err"><%= errors.confirm_password %></p><% } %>

      <button type="submit">Register</button>
    </form>

    <p class="alt">Already registered? <a href="/account/login">Sign in</a></p>

    <%- include('_portals') %>

    <p class="hint" style="margin-top:18px">
      Registering writes to two databases at once: this portal's shared database and
      the ERP's own, over <code><%= erpTarget %></code>. If the ERP will not accept it,
      nothing is saved on either side.
    </p>
  </div>
</div>
</body>
</html>
