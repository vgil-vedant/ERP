        ]}
      ];
      /* ERP console address — reads ERP_HOST and ERP_PORT the same way erp-client.js does */
      var ERP_HOST = process.env.ERP_HOST || '127.0.0.1';
      var ERP_PORT = Number(process.env.ERP_PORT) || 4200;
      var ERP_URL  = 'http://' + ERP_HOST + ':' + ERP_PORT;
