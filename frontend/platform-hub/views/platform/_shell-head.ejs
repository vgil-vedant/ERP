<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title><%= title %></title>
<style>
/* ================================================================
   4_ERP · ERP HUB CONSOLE — Production UI
   Design tokens derived from erphub.html reference.
   No external assets. All inline.
   ================================================================ */

/* ---------- Design tokens ---------- */
:root {
  /* brand */
  --ink: #0F1714;
  --ink-hover: #1C2B25;

  /* mint / emerald */
  --mint-50: #F2FBF6;
  --mint-100: #E4F7EC;
  --mint-200: #CFEFDE;
  --mint-300: #AEE2C8;
  --mint-400: #7FD3AE;
  --emerald: #0E9F6B;
  --emerald-deep: #0A7C54;
  --emerald-ink: #064D36;

  /* status */
  --success: #0E9F6B;
  --success-bg: #E6F7EE;
  --warning: #B67C24;
  --warning-bg: #FBF0DC;
  --danger: #C1514A;
  --danger-bg: #F9E5E2;
  --info: #3C7F94;
  --info-bg: #E7F1F4;

  /* neutrals */
  --canvas: #F1F8F4;
  --surface: #FFFFFF;
  --surface-2: #F7FBF9;
  --surface-3: #EFF6F2;
  --border: #E4EDE8;
  --border-strong: #D2E1D9;
  --text: #101A16;
  --text-2: #586862;
  --text-3: #87968F;
  --text-4: #A9B7B1;

  /* typography */
  --font: 'Plus Jakarta Sans', 'Inter', 'Segoe UI', system-ui, -apple-system, 'Helvetica Neue', Arial, sans-serif;
  --mono: ui-monospace, 'SF Mono', 'JetBrains Mono', 'Roboto Mono', Menlo, Consolas, monospace;

  /* radii */
  --r-xl: 24px;
  --r-lg: 20px;
  --r-md: 14px;
  --r-sm: 11px;
  --r-xs: 8px;
  --r-pill: 999px;

  /* shadows */
  --sh-xs: 0 1px 2px rgba(11,35,26,.05);
  --sh-sm: 0 1px 2px rgba(11,35,26,.05), 0 8px 20px -16px rgba(11,35,26,.35);
  --sh-md: 0 1px 2px rgba(11,35,26,.04), 0 16px 34px -24px rgba(11,35,26,.35);
  --sh-lg: 0 24px 64px -32px rgba(11,35,26,.42);

  /* layout */
  --sidebar-w: 278px;
  --sidebar-rail: 84px;
  --topbar-h: 70px;
}

*, *::before, *::after { box-sizing: border-box; }
html, body { height: 100%; }
body {
  margin: 0;
  font-family: var(--font);
  background: var(--canvas);
  color: var(--text);
  font-size: 14px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}
body.no-scroll { overflow: hidden; }
h1, h2, h3, h4, p { margin: 0; }
button, input, select, textarea { font-family: inherit; }
a { color: inherit; text-decoration: none; }
::selection { background: var(--mint-300); color: var(--ink); }
:focus-visible { outline: 2px solid var(--emerald); outline-offset: 2px; border-radius: 6px; }

*::-webkit-scrollbar { width: 10px; height: 10px; }
*::-webkit-scrollbar-thumb { background: #D8E6DE; border-radius: 999px; border: 3px solid transparent; background-clip: content-box; }
*::-webkit-scrollbar-thumb:hover { background: #C2D8CC; background-clip: content-box; }
*::-webkit-scrollbar-track { background: transparent; }

/* ================================================================
   DEMO NOTICE BANNER
   ================================================================ */
.demo-notice {
  background: #7f1d1d;
  color: #fff;
  padding: 6px 16px;
  font-size: 12px;
  letter-spacing: .03em;
  text-align: center;
  font-weight: 600;
  position: relative;
  z-index: 200;
}

/* ================================================================
   APP SHELL
   ================================================================ */
.app { display: flex; min-height: 100vh; }

/* -------- Sidebar -------- */
.sidebar {
  position: fixed; inset: 0 auto 0 0;
  width: var(--sidebar-w);
  display: flex; flex-direction: column;
  background: linear-gradient(180deg, #F6FCF9 0%, #FFFFFF 34%, #FFFFFF 100%);
  border-right: 1px solid var(--border);
  z-index: 60;
  transition: width .28s cubic-bezier(.4,0,.2,1), transform .28s cubic-bezier(.4,0,.2,1);
  overflow: hidden;
}
.sidebar::after {
  content: ''; position: absolute; inset: 0 0 auto 0; height: 180px; pointer-events: none;
  background: radial-gradient(180px 140px at 12% 0%, rgba(174,226,200,.55), rgba(174,226,200,0) 72%);
}

/* Brand block */
.brand {
  display: flex; align-items: center; gap: 11px;
  padding: 20px 18px 16px; position: relative; z-index: 1;
  flex-shrink: 0;
}
.brand-close {
  display: none; width: 32px; height: 32px; flex: 0 0 32px; border-radius: 9px;
  border: 1px solid var(--border); background: #fff; color: var(--text-2);
  place-items: center; cursor: pointer; transition: .16s;
}
.brand-close:hover { background: var(--mint-50); color: var(--emerald); border-color: var(--mint-300); }
.brand-close svg { width: 15px; height: 15px; }

.brand-mark {
  width: 38px; height: 38px; flex: 0 0 38px; border-radius: 12px;
  background: linear-gradient(145deg, #0F1714, #21362D);
  display: grid; place-items: center; color: #C7F3DC;
  box-shadow: 0 8px 18px -12px rgba(11,35,26,.9);
  flex-shrink: 0;
}
.brand-mark svg { width: 20px; height: 20px; }
.brand-text { min-width: 0; flex: 1; }
.brand-name { font-size: 15px; font-weight: 800; letter-spacing: -.02em; line-height: 1.15; white-space: nowrap; }
.brand-sub { font-size: 10.5px; font-weight: 600; color: var(--text-3); letter-spacing: .06em; text-transform: uppercase; white-space: nowrap; margin-top: 3px; }

/* Status card */
.workspace-cta {
  margin: 0 16px 6px; padding: 10px 11px; border-radius: var(--r-md);
  background: linear-gradient(120deg, #F0FAF4, #EAF7F1);
  border: 1px solid var(--mint-200);
  display: flex; align-items: center; gap: 9px;
  flex-shrink: 0;
}
.ws-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--emerald); box-shadow: 0 0 0 3px rgba(14,159,107,.14); flex: 0 0 8px; }
.ws-main { min-width: 0; }
.ws-title { font-size: 11.5px; font-weight: 700; color: var(--emerald-ink); letter-spacing: .01em; white-space: nowrap; }
.ws-sub { font-size: 10.5px; color: #5F8577; font-family: var(--mono); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* Nav */
.nav { flex: 1; min-height: 0; overflow-y: auto; overflow-x: hidden; padding: 10px 12px 18px; position: relative; z-index: 1; }
.nav-group { margin-bottom: 6px; }
.nav-group-head {
  display: flex; align-items: center; gap: 8px; width: 100%;
  background: none; border: 0; cursor: pointer;
  padding: 14px 10px 8px; color: var(--text-3);
  font-size: 10px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase;
}
.nav-group-head .grp-index { color: var(--mint-400); font-variant-numeric: tabular-nums; }
.nav-group-head .grp-chev { margin-left: auto; transition: transform .22s ease; opacity: .55; }
.nav-group.is-closed .grp-chev { transform: rotate(-90deg); }
.nav-group.is-closed .nav-items { display: none; }
.nav-items { display: flex; flex-direction: column; gap: 2px; }

.nav-item {
  position: relative; display: flex; align-items: center; gap: 11px;
  height: 40px; padding: 0 11px; border-radius: 12px;
  color: #4E5F58; font-size: 13.5px; font-weight: 600; letter-spacing: -.01em;
  cursor: pointer; border: 0; background: none; width: 100%; text-align: left;
  transition: background .16s ease, color .16s ease;
  white-space: nowrap;
  text-decoration: none;
}
.nav-item .ic { width: 19px; height: 19px; flex: 0 0 19px; color: #7C8D86; transition: color .16s ease; }
.nav-item:hover { background: var(--mint-50); color: var(--ink); }
.nav-item:hover .ic { color: var(--emerald); }
.nav-item.is-active {
  background: linear-gradient(90deg, #E7F7EE, #F3FBF7 70%);
  color: var(--emerald-ink);
  box-shadow: inset 0 0 0 1px rgba(174,226,200,.55);
}
.nav-item.is-active .ic { color: var(--emerald); }
.nav-item.is-active::before {
  content: ''; position: absolute; left: -12px; top: 50%; transform: translateY(-50%);
  width: 3px; height: 20px; border-radius: 0 3px 3px 0; background: var(--emerald);
}
.nav-label { flex: 1; overflow: hidden; text-overflow: ellipsis; }
.nav-badge {
  font-size: 10.5px; font-weight: 700; padding: 1px 7px; border-radius: var(--r-pill);
  background: var(--mint-100); color: var(--emerald-ink); font-variant-numeric: tabular-nums;
}
.nav-item.is-active .nav-badge { background: #fff; box-shadow: var(--sh-xs); }

/* Sidebar footer */
.sidebar-foot {
  border-top: 1px solid var(--border); padding: 12px 14px 14px;
  display: flex; flex-direction: column; gap: 8px; background: #fff; position: relative; z-index: 1;
  flex-shrink: 0;
}
.sf-note {
  font-size: 10.5px; line-height: 1.45; color: var(--text-3);
  background: var(--surface-2); border: 1px solid var(--border);
  padding: 8px 9px; border-radius: 10px;
}
.sf-note b { color: var(--text-2); font-weight: 700; }
.sf-row { display: flex; align-items: center; gap: 8px; }
.sf-version { font-size: 10.5px; color: var(--text-3); font-family: var(--mono); }
.collapse-btn {
  margin-left: auto; width: 32px; height: 32px; display: grid; place-items: center;
  border: 1px solid var(--border); background: #fff; border-radius: 9px; cursor: pointer; color: var(--text-2);
  transition: .16s;
}
.collapse-btn:hover { background: var(--mint-50); color: var(--emerald); border-color: var(--mint-300); }
.collapse-btn svg { width: 15px; height: 15px; transition: transform .28s ease; }

/* -------- Collapsed rail -------- */
.app.is-collapsed .sidebar { width: var(--sidebar-rail); }
.app.is-collapsed .brand { padding: 20px 0 16px; justify-content: center; }
.app.is-collapsed .brand-text,
.app.is-collapsed .workspace-cta,
.app.is-collapsed .nav-label,
.app.is-collapsed .nav-badge,
.app.is-collapsed .sf-note,
.app.is-collapsed .sf-version { display: none; }
.app.is-collapsed .nav-item { justify-content: center; padding: 0; height: 40px; }
.app.is-collapsed .nav-item.is-active::before { display: none; }
.app.is-collapsed .nav-group-head { justify-content: center; padding: 14px 0 8px; height: auto; }
.app.is-collapsed .nav-group-head > *:not(.grp-index) { display: none; }
.app.is-collapsed .sidebar-foot { align-items: center; }
.app.is-collapsed .collapse-btn { margin-left: 0; }
.app.is-collapsed .collapse-btn svg { transform: rotate(180deg); }

/* Tooltip for collapsed items */
.app.is-collapsed .nav-item { position: relative; }
.app.is-collapsed .nav-item::after {
  content: attr(data-label);
  position: absolute; left: calc(100% + 12px); top: 50%; transform: translateY(-50%);
  background: var(--ink); color: #fff; font-size: 12px; font-weight: 600;
  padding: 5px 10px; border-radius: 8px; white-space: nowrap;
  opacity: 0; pointer-events: none; transition: opacity .14s ease;
  z-index: 999;
}
.app.is-collapsed .nav-item:hover::after { opacity: 1; }

/* -------- Shell / main area -------- */
.shell {
  margin-left: var(--sidebar-w);
  display: flex; flex-direction: column; min-height: 100vh; flex: 1;
  transition: margin-left .28s cubic-bezier(.4,0,.2,1);
}
.app.is-collapsed .shell { margin-left: var(--sidebar-rail); }

/* Scrim */
.scrim {
  position: fixed; inset: 0; background: rgba(10,28,22,.38);
  z-index: 50; transition: opacity .24s ease;
}
.scrim[hidden] { display: none; }

/* -------- Top bar -------- */
.topbar {
  position: sticky; top: 0; z-index: 40;
  height: var(--topbar-h);
  display: flex; align-items: center; gap: 14px; padding: 0 26px;
  background: rgba(255,255,255,.85); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
}
.menu-btn {
  display: none; width: 38px; height: 38px; flex: 0 0 38px; border-radius: 10px;
  border: 1px solid var(--border); background: #fff; color: var(--text-2);
  place-items: center; cursor: pointer; transition: .16s;
}
.menu-btn:hover { background: var(--mint-50); color: var(--emerald); border-color: var(--mint-300); }
.menu-btn svg { width: 18px; height: 18px; }

.crumbs { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--text-3); }
.crumbs .root { font-weight: 700; color: var(--text-2); }
.crumbs a.root { text-decoration: none; }
.crumbs a.root:hover { color: var(--emerald-deep, #0B7A52); text-decoration: underline; text-underline-offset: 3px; }
.crumbs .sep { color: var(--border-strong); }
.crumbs .now { font-weight: 600; color: var(--text); }

.topbar-search { margin-left: auto; max-width: 280px; width: 100%; position: relative; }
.search-field {
  display: flex; align-items: center; gap: 8px;
  background: var(--surface-2); border: 1px solid var(--border);
  border-radius: var(--r-sm); padding: 0 10px; height: 36px;
  transition: border-color .15s, box-shadow .15s;
}
.search-field:focus-within { border-color: var(--emerald); box-shadow: 0 0 0 3px rgba(14,159,107,.12); background: #fff; }
.search-field svg { width: 15px; height: 15px; color: var(--text-3); flex-shrink: 0; }
.search-field input {
  flex: 1; border: none; background: none; font-size: 13px; color: var(--text); outline: none;
  min-width: 0;
}
.search-field input::placeholder { color: var(--text-4); }
.kbd {
  font-size: 10px; font-family: var(--mono); color: var(--text-4);
  border: 1px solid var(--border-strong); border-radius: 4px;
  padding: 1px 5px; line-height: 1.6; flex-shrink: 0;
}

.topbar-right { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
.chip-service {
  display: flex; align-items: center; gap: 6px;
  background: var(--surface-2); border: 1px solid var(--border);
  border-radius: var(--r-pill); padding: 4px 10px 4px 8px;
  font-size: 12px; font-weight: 600; color: var(--text-2); cursor: pointer;
  transition: .15s;
}
.chip-service:hover { background: var(--mint-100); border-color: var(--mint-300); color: var(--emerald-ink); }
.chip-service .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--emerald); box-shadow: 0 0 0 2px rgba(14,159,107,.2); }
.chip-service code { font-family: var(--mono); font-size: 10.5px; color: var(--text-3); }
.chip-date {
  display: flex; align-items: center; gap: 5px;
  background: var(--surface-2); border: 1px solid var(--border);
  border-radius: var(--r-pill); padding: 4px 10px;
  font-size: 12px; font-weight: 500; color: var(--text-2);
}
.chip-date svg { width: 14px; height: 14px; color: var(--text-3); }

/* -------- Main content -------- */
.main {
  flex: 1; padding: 24px 26px 40px;
  max-width: 1560px; width: 100%;
}

/* -------- App footer -------- */
.app-foot {
  border-top: 1px solid var(--border); padding: 13px 26px;
  font-size: 11.5px; color: var(--text-3); display: flex; align-items: center; gap: 8px;
  flex-shrink: 0;
}
.app-foot b { color: var(--text-2); }

/* ================================================================
   PAGE PATTERNS
   ================================================================ */
.page-head {
  display: flex; align-items: flex-start; justify-content: space-between;
  gap: 16px; margin-bottom: 22px; flex-wrap: wrap;
}
.page-title {
  font-size: 27px; font-weight: 800; letter-spacing: -.035em; line-height: 1.15; color: var(--ink);
}
.page-desc {
  font-size: 13px; color: var(--text-2); margin-top: 5px; max-width: 580px; line-height: 1.55;
}
.page-actions { display: flex; align-items: center; gap: 8px; flex-shrink: 0; flex-wrap: wrap; }

/* -------- Buttons -------- */
.btn {
  display: inline-flex; align-items: center; gap: 6px;
  height: 36px; padding: 0 14px; border-radius: var(--r-sm);
  border: 1px solid var(--border-strong); background: #fff; color: var(--text);
  font-size: 13px; font-weight: 600; cursor: pointer; transition: .15s;
  white-space: nowrap;
}
.btn svg { width: 15px; height: 15px; flex-shrink: 0; }
.btn:hover { background: var(--mint-50); border-color: var(--mint-300); color: var(--emerald-ink); }
.btn-primary {
  background: var(--ink); color: #fff; border-color: var(--ink);
}
.btn-primary:hover { background: var(--ink-hover); border-color: var(--ink-hover); color: #fff; }
.btn-sm { height: 30px; padding: 0 10px; font-size: 12px; }

/* -------- Cards -------- */
.card {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--r-lg); box-shadow: var(--sh-sm);
  display: flex; flex-direction: column;
}
.card-head {
  display: flex; align-items: flex-start; justify-content: space-between; gap: 12px;
  padding: 16px 20px 12px; border-bottom: 1px solid var(--border); flex-shrink: 0;
}
.card-title { font-size: 14px; font-weight: 700; color: var(--text); }
.card-sub { font-size: 12px; color: var(--text-3); margin-top: 2px; }
.card-body { padding: 16px 20px; flex: 1; }
.card-foot {
  border-top: 1px solid var(--border); padding: 10px 20px;
  display: flex; align-items: center; gap: 10px; flex-shrink: 0;
}

/* -------- KPI cards -------- */
.g-kpi {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px; margin-bottom: 16px;
}
.card.kpi { padding: 18px 20px 16px; gap: 4px; }
.kpi-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
.kpi-ic {
  width: 38px; height: 38px; border-radius: var(--r-sm);
  background: var(--surface-3); display: grid; place-items: center;
  color: var(--emerald);
}
.kpi-ic svg { width: 20px; height: 20px; }
.kpi-label { font-size: 12px; font-weight: 600; color: var(--text-3); letter-spacing: .02em; text-transform: uppercase; }
.kpi-value {
  font-size: 36px; font-weight: 800; letter-spacing: -.04em; line-height: 1.1;
  color: var(--ink); font-variant-numeric: tabular-nums;
}
.kpi-note { font-size: 11.5px; color: var(--text-3); margin-top: 6px; }

/* -------- Pills -------- */
.pill {
  display: inline-flex; align-items: center; gap: 5px;
  font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: var(--r-pill);
  white-space: nowrap;
}
.pill-mint { background: var(--mint-100); color: var(--emerald-ink); }
.pill-ok { background: var(--success-bg); color: #065F46; }
.pill-warn { background: var(--warning-bg); color: #92400E; }
.pill-danger { background: var(--danger-bg); color: #991B1B; }
.pill-info { background: var(--info-bg); color: #164E63; }
.pill-neutral { background: var(--surface-3); color: var(--text-2); border: 1px solid var(--border); }

/* -------- Grid helpers -------- */
.grid { display: grid; gap: 14px; }
.g-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.g-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.g-ab { grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); }

/* -------- Tables -------- */
.tbl-wrap { overflow-x: auto; }
table.tbl {
  width: 100%; border-collapse: collapse; font-size: 13.5px;
  min-width: 640px;
}
table.tbl thead th {
  text-align: left; padding: 10px 12px;
  font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: .09em;
  color: var(--text-3); background: var(--surface-2);
  border-bottom: 1px solid var(--border); white-space: nowrap;
  position: sticky; top: 0;
}
table.tbl thead th:first-child { border-radius: var(--r-sm) 0 0 0; padding-left: 20px; }
table.tbl thead th:last-child  { border-radius: 0 var(--r-sm) 0 0; }
table.tbl tbody td { padding: 11px 12px; border-bottom: 1px solid #F0F5F2; vertical-align: top; }
table.tbl tbody td:first-child { padding-left: 20px; }
table.tbl tbody tr:last-child td { border-bottom: none; }
table.tbl tbody tr:hover td { background: var(--mint-50); }
table.tbl tbody tr.clickable { cursor: pointer; }

/* Sortable headers */
table.tbl th[data-sort] { cursor: pointer; user-select: none; }
table.tbl th[data-sort]:hover { color: var(--emerald-ink); }
table.tbl th[data-sort].sort-asc::after  { content: ' ↑'; }
table.tbl th[data-sort].sort-desc::after { content: ' ↓'; }

/* Monospace chips */
.mono-chip {
  font-family: var(--mono); font-size: 11.5px;
  background: var(--surface-3); border: 1px solid var(--border);
  padding: 2px 7px; border-radius: 6px; color: var(--text-2);
  display: inline-block;
}

/* Source system chips */
.sys-chip {
  display: inline-block; font-size: 11px; font-weight: 700;
  padding: 2px 8px; border-radius: var(--r-pill);
  background: var(--mint-100); color: var(--emerald-ink);
  white-space: nowrap;
}

/* -------- Table toolbar -------- */
.tbl-toolbar {
  display: flex; align-items: center; gap: 8px;
  padding: 10px 20px; border-bottom: 1px solid var(--border);
  flex-wrap: wrap;
}
.filter-chips { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
.filter-chip {
  font-size: 12px; font-weight: 600; padding: 4px 10px; border-radius: var(--r-pill);
  border: 1px solid var(--border); background: #fff; color: var(--text-2);
  cursor: pointer; transition: .14s; white-space: nowrap;
}
.filter-chip:hover { background: var(--mint-50); border-color: var(--mint-300); color: var(--emerald-ink); }
.filter-chip.is-active { background: var(--ink); color: #fff; border-color: var(--ink); }
.tbl-search-wrap { margin-left: auto; max-width: 220px; width: 100%; }
.tbl-search {
  display: flex; align-items: center; gap: 6px;
  height: 32px; padding: 0 10px; border-radius: var(--r-sm);
  border: 1px solid var(--border); background: var(--surface-2);
  transition: border-color .15s;
}
.tbl-search:focus-within { border-color: var(--emerald); background: #fff; }
.tbl-search svg { width: 14px; height: 14px; color: var(--text-4); flex-shrink: 0; }
.tbl-search input { flex: 1; border: none; background: none; font-size: 12.5px; color: var(--text); outline: none; }

/* -------- Pager -------- */
.pager {
  display: flex; align-items: center; gap: 8px; padding: 10px 20px;
  border-top: 1px solid var(--border); flex-shrink: 0;
}
.pager-info { font-size: 12px; color: var(--text-3); margin-right: auto; }
.pager-btn {
  width: 28px; height: 28px; display: grid; place-items: center;
  border: 1px solid var(--border); border-radius: 7px; background: #fff;
  color: var(--text-2); cursor: pointer; font-size: 12px; transition: .14s;
}
.pager-btn:hover { background: var(--mint-50); border-color: var(--mint-300); color: var(--emerald-ink); }
.pager-btn:disabled { opacity: .4; cursor: default; }
.pager-btn svg { width: 14px; height: 14px; }

/* -------- Empty state -------- */
.empty-state {
  padding: 48px 24px; text-align: center;
}
.empty-icon {
  width: 48px; height: 48px; border-radius: 14px;
  background: var(--surface-3); display: grid; place-items: center;
  color: var(--text-4); margin: 0 auto 14px;
}
.empty-icon svg { width: 24px; height: 24px; }
.empty-title { font-size: 15px; font-weight: 700; color: var(--text-2); }
.empty-hint { font-size: 13px; color: var(--text-3); margin-top: 5px; }

/* -------- Audit feed -------- */
.feed { display: flex; flex-direction: column; gap: 0; padding: 4px 0; }
.feed-item {
  display: flex; align-items: flex-start; gap: 12px;
  padding: 12px 20px; border-bottom: 1px solid var(--border);
}
.feed-item:last-child { border-bottom: none; }
.feed-dot {
  width: 8px; height: 8px; border-radius: 50%; background: var(--emerald);
  flex-shrink: 0; margin-top: 6px;
}
.feed-dot.warn { background: var(--warning); }
.feed-dot.info { background: var(--info); }
.feed-body { flex: 1; min-width: 0; }
.feed-action { font-size: 13px; font-weight: 700; color: var(--text); }
.feed-meta { font-size: 12px; color: var(--text-3); margin-top: 2px; }
.feed-time { font-size: 11px; color: var(--text-4); font-family: var(--mono); margin-left: auto; flex-shrink: 0; padding-top: 2px; }

/* -------- Portal cards -------- */
.portal-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; }
.portal-card {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--r-md); padding: 16px; box-shadow: var(--sh-xs);
  display: flex; flex-direction: column; gap: 10px;
  transition: box-shadow .16s, border-color .16s;
}
.portal-card:hover { box-shadow: var(--sh-md); border-color: var(--mint-300); }
.portal-head { display: flex; align-items: center; gap: 10px; }
.portal-icon {
  width: 38px; height: 38px; border-radius: 10px;
  background: linear-gradient(135deg, var(--mint-100), var(--mint-200));
  display: grid; place-items: center; color: var(--emerald); flex-shrink: 0;
}
.portal-icon svg { width: 20px; height: 20px; }
.portal-name { font-size: 13.5px; font-weight: 700; color: var(--text); }
.portal-category { font-size: 11px; color: var(--text-3); margin-top: 1px; }
.portal-host { font-family: var(--mono); font-size: 11px; color: var(--text-4); }
.portal-count { font-size: 22px; font-weight: 800; color: var(--ink); letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
.portal-count-label { font-size: 11px; color: var(--text-3); }

/* -------- Detail Drawer -------- */
.drawer-backdrop {
  position: fixed; inset: 0; background: rgba(10,28,22,.28); z-index: 70;
  transition: opacity .22s ease; opacity: 0; pointer-events: none;
}
.drawer-backdrop.is-open { opacity: 1; pointer-events: auto; }
.drawer {
  position: fixed; inset: 0 0 0 auto; width: 420px; max-width: 94vw;
  background: var(--surface); border-left: 1px solid var(--border);
  box-shadow: var(--sh-lg); z-index: 80; display: flex; flex-direction: column;
  transform: translateX(100%); transition: transform .26s cubic-bezier(.4,0,.2,1);
}
.drawer.is-open { transform: translateX(0); }
.drawer-head {
  display: flex; align-items: center; gap: 10px;
  padding: 18px 20px 14px; border-bottom: 1px solid var(--border); flex-shrink: 0;
}
.drawer-title { font-size: 15px; font-weight: 700; color: var(--text); flex: 1; }
.drawer-close {
  width: 32px; height: 32px; display: grid; place-items: center;
  border: 1px solid var(--border); border-radius: 8px; background: #fff;
  color: var(--text-2); cursor: pointer; transition: .14s; flex-shrink: 0;
}
.drawer-close:hover { background: var(--mint-50); color: var(--emerald); border-color: var(--mint-300); }
.drawer-close svg { width: 15px; height: 15px; }
.drawer-body { flex: 1; overflow-y: auto; padding: 16px 20px; display: flex; flex-direction: column; gap: 16px; }
.drawer-section-title { font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: .1em; color: var(--text-3); margin-bottom: 8px; }
.kv-list { display: flex; flex-direction: column; gap: 0; border: 1px solid var(--border); border-radius: var(--r-sm); overflow: hidden; }
.kv-row { display: grid; grid-template-columns: 120px 1fr; border-bottom: 1px solid var(--border); }
.kv-row:last-child { border-bottom: none; }
.kv-key { padding: 9px 12px; font-size: 11.5px; font-weight: 600; color: var(--text-3); background: var(--surface-2); }
.kv-val { padding: 9px 12px; font-size: 12.5px; color: var(--text); word-break: break-word; }

/* -------- Toast -------- */
.toasts { position: fixed; bottom: 24px; right: 24px; z-index: 200; display: flex; flex-direction: column; gap: 8px; pointer-events: none; }
.toast {
  display: flex; align-items: center; gap: 10px;
  background: var(--ink); color: #fff; border-radius: var(--r-sm);
  padding: 11px 16px; font-size: 13px; font-weight: 600;
  box-shadow: var(--sh-lg); pointer-events: auto;
  animation: slideUp .22s ease both;
}
.toast svg { width: 16px; height: 16px; flex-shrink: 0; color: var(--mint-400); }
@keyframes slideUp {
  from { opacity: 0; transform: translateY(12px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* -------- Bar charts (CSS only) -------- */
.bar-chart { display: flex; flex-direction: column; gap: 10px; padding: 4px 0; }
.bar-row { display: grid; grid-template-columns: 90px 1fr 48px; align-items: center; gap: 10px; }
.bar-label { font-size: 12px; font-weight: 600; color: var(--text-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.bar-track { background: var(--surface-3); border-radius: var(--r-pill); height: 10px; overflow: hidden; }
.bar-fill { height: 100%; border-radius: var(--r-pill); background: var(--emerald); transition: width .5s ease; }
.bar-val { font-size: 12px; font-weight: 700; color: var(--text); text-align: right; font-variant-numeric: tabular-nums; }

/* ================================================================
   RESPONSIVE
   ================================================================ */
@media (max-width: 1200px) {
  .g-kpi { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .g-ab { grid-template-columns: 1fr; }
}
@media (max-width: 900px) {
  :root { --topbar-h: 64px; }
  .sidebar { transform: translateX(-100%); width: min(300px, 86vw); box-shadow: var(--sh-lg); }
  .app.nav-open .sidebar { transform: none; }
  .app.is-collapsed .sidebar { width: min(300px, 86vw); }
  .app.is-collapsed .brand { padding: 20px 18px 16px; justify-content: flex-start; }
  .app.is-collapsed .brand-text,
  .app.is-collapsed .workspace-cta,
  .app.is-collapsed .nav-label,
  .app.is-collapsed .nav-badge,
  .app.is-collapsed .sf-note,
  .app.is-collapsed .sf-version { display: revert; }
  .app.is-collapsed .nav-item { justify-content: flex-start; padding: 0 11px; }
  .app.is-collapsed .nav-item::after { display: none; }
  .app.is-collapsed .nav-group-head { justify-content: flex-start; padding: 14px 10px 8px; }
  .app.is-collapsed .nav-group-head > * { display: revert; }
  .app.is-collapsed .collapse-btn { margin-left: auto; }
  .shell, .app.is-collapsed .shell { margin-left: 0; }
  .menu-btn { display: grid; }
  .collapse-btn { display: none; }
  .topbar { padding: 0 14px; gap: 10px; }
  .main { padding: 18px 16px 28px; }
  .g-2, .g-3 { grid-template-columns: 1fr; }
  .chip-date, .chip-service { display: none; }
  .drawer { width: 100%; }
}
@media (max-width: 640px) {
  .g-kpi { grid-template-columns: 1fr; }
  .page-head { flex-direction: column; }
  .page-actions { width: 100%; }
  .page-actions .btn { flex: 1; }
  .topbar-search { display: none; }
}

/* ================================================================
   PRINT
   ================================================================ */
@media print {
  .sidebar, .topbar, .toasts, .demo-notice, .drawer, .drawer-backdrop { display: none !important; }
  .shell { margin: 0 !important; }
  .card { box-shadow: none; break-inside: avoid; }
}

/* ================================================================
   REDUCED MOTION
   ================================================================ */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: .001ms !important; transition-duration: .001ms !important; }
}

/* -------- Hub layout fixes -------- */
