<%- include('_head') %>
<div class="wrap">
  <div class="panel">
    <h1>Sign in</h1>
    <p class="lede">
      One account covers every portal in this demonstration. Sign in here and you are
      signed in on all of them.
    </p>

    <form method="post" action="/account/login<%= next ? '?next=' + encodeURIComponent(next) : '' %>" novalidate>
      <label for="email">Email</label>
      <input id="email" name="email" type="email" required
             class="<%= errors.email ? 'bad' : '' %>" value="<%= form.email || '' %>">

      <label for="password">Password</label>
      <input id="password" name="password" type="password" required>
      <% if (errors.email) { %><p class="err"><%= errors.email %></p><% } %>

      <button type="submit">Sign in</button>
    </form>

    <p class="alt">No account yet? <a href="/account/register">Register once</a></p>

    <%- include('_portals') %>
  </div>
</div>
</body>
</html>
