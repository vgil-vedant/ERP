<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %></title>
<style>
  :root{--bg:#0f172a;--panel:#ffffff;--ink:#101828;--muted:#5b6678;--line:#e4e8ef;
        --accent:#1d4ed8;--ok:#047857;--warn:#b45309;--chip:#eef2ff}
  *{box-sizing:border-box}
  body{margin:0;font:15px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
       color:var(--ink);background:#f4f6fa}
  .notice{background:#7f1d1d;color:#fff;padding:7px 16px;font-size:12.5px;
          letter-spacing:.02em;text-align:center}
  header{background:var(--bg);color:#fff;padding:18px 24px}
  header h1{margin:0;font-size:19px;font-weight:600}
  header p{margin:4px 0 0;font-size:13px;color:#9fb0c9}
  nav{background:#1b2740;padding:0 24px;display:flex;gap:2px;flex-wrap:wrap}
  nav a{color:#c8d4e8;text-decoration:none;padding:11px 15px;font-size:13.5px}
  nav a.on{background:#f4f6fa;color:var(--ink);font-weight:600}
  main{padding:24px;max-width:1180px;margin:0 auto}
  .cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:14px;margin-bottom:26px}
  .card{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:16px 18px}
  .card b{display:block;font-size:30px;line-height:1.1;font-weight:650}
  .card span{font-size:12.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
  h2{font-size:16px;margin:0 0 12px}
  table{width:100%;border-collapse:collapse;background:var(--panel);
        border:1px solid var(--line);border-radius:10px;overflow:hidden;font-size:13.5px}
  th{text-align:left;background:#f7f9fc;padding:10px 12px;font-size:12px;
     text-transform:uppercase;letter-spacing:.04em;color:var(--muted);border-bottom:1px solid var(--line)}
  td{padding:10px 12px;border-bottom:1px solid #f0f2f6;vertical-align:top}
  tr:last-child td{border-bottom:none}
  code{font:12.5px ui-monospace,Menlo,Consolas,monospace;background:#f1f3f7;
       padding:1px 5px;border-radius:4px}
  .chip{display:inline-block;background:var(--chip);color:var(--accent);
        border-radius:20px;padding:2px 9px;font-size:11.5px;font-weight:600}
  .empty{background:var(--panel);border:1px dashed #c8d0dd;border-radius:10px;
         padding:34px;text-align:center;color:var(--muted)}
  .fields{margin:0;font-size:12.5px;color:var(--muted)}
  .fields div{padding:1px 0}
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){--panel:#161c27;--ink:#e8ecf3;--muted:#92a0b5;
      --line:#2a3342;--chip:#1e293b}
    :root:not([data-theme="light"]) body{background:#0c1118}
    :root:not([data-theme="light"]) th{background:#1b2230}
    :root:not([data-theme="light"]) td{border-bottom-color:#232c3a}
    :root:not([data-theme="light"]) code{background:#232c3a}
  }
</style>
</head>
<body>
<div class="notice">Unofficial Local Demonstration &mdash; Not an Official Government Service</div>
<header>
  <h1>ERP &mdash; Intake Console</h1>
  <p>Records arriving from the demonstration portals. This is the ERP's own database.</p>
</header>
<nav>
  <a href="/" class="<%= currentPath === '/' ? 'on' : '' %>">Overview</a>
  <a href="/intake" class="<%= currentPath === '/intake' ? 'on' : '' %>">Received records</a>
  <a href="/citizens" class="<%= currentPath === '/citizens' ? 'on' : '' %>">Citizens</a>
  <a href="/audit" class="<%= currentPath === '/audit' ? 'on' : '' %>">Audit trail</a>
</nav>
<main>
