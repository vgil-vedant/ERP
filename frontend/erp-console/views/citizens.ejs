<%- include('layout-head') %>
<h2>Citizens <span style="font-weight:400;color:var(--muted)">(<%= rows.length %>)</span></h2>
<p style="font-size:13px;color:var(--muted);margin-top:0">
  One row per person. They registered once, on one portal, and the
  <strong>Used on</strong> column shows every portal that has since sent data for them
  &mdash; with no second registration.
</p>
<% if (!rows.length) { %>
  <div class="empty">No citizen has registered yet.</div>
<% } else { %>
  <table>
    <tr><th>ERP citizen ref</th><th>Name</th><th>Email</th><th>Mobile</th>
        <th>Registered on</th><th>Used on</th><th>Records</th></tr>
    <% rows.forEach(function (c) { %>
      <tr>
        <td><code><%= c.citizen_ref %></code></td>
        <td><strong><%= c.full_name %></strong></td>
        <td><%= c.email %></td>
        <td><%= c.mobile || '—' %></td>
        <td><span class="chip"><%= c.first_seen_in %></span><br>
            <span style="font-size:11.5px;color:var(--muted)"><%= c.registered_on %></span></td>
        <td><% (c.systems ? c.systems.split(',') : []).forEach(function (s) { %><span class="chip" style="margin:1px"><%= s %></span> <% }); %>
            <% if (!c.systems) { %>&mdash;<% } %></td>
        <td><%= c.intake_count %></td>
      </tr>
    <% }); %>
  </table>
<% } %>
<%- include('layout-foot') %>
