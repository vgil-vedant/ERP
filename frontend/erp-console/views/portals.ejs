<%- include('layout-head') %>

<%
  /* ── Portal metadata map ─────────────────────────────────────────────── */
  var META = {
    eprisons:   { icon: '<path d="M4 21V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v15"/><path d="M8 8v13M12 8v13M16 8v13M3 21h18"/>', color: '#0E9F6B' },
    cctns:      { icon: '<path d="M12 3 4 6v6c0 4.4 3.4 8.2 8 9.5 4.6-1.3 8-5.1 8-9.5V6l-8-3Z"/><path d="M12 8v8M8.5 11h7"/>', color: '#2BAFA0' },
    eforensics: { icon: '<path d="M9 3h6M10 3v6l-5.5 9.5A2 2 0 0 0 6.2 21h11.6a2 2 0 0 0 1.7-2.5L14 9V3"/><path d="M7.5 15h9"/>', color: '#7FD3AE' },
    uidai:      { icon: '<path d="M12 4a8 8 0 0 1 8 8v2"/><path d="M4 12a8 8 0 0 1 8-8"/><path d="M8 12a4 4 0 0 1 8 0v3a9 9 0 0 0 .6 3"/><path d="M7 20a13 13 0 0 1-.6-4v-4"/><path d="M11 12v5a7 7 0 0 0 .5 2.5"/>', color: '#0A7C54' },
    ecourts:    { icon: '<path d="M12 3v3M5 20h14M6 20V10m12 10V10M3 10h18"/><path d="M12 6 3 10h18L12 6Z"/><path d="M9 20v-5m6 5v-5"/>', color: '#2B4A42' },
  };

  /* ── Enrich systems list ─────────────────────────────────────────────── */
  var enriched = systems.map(function(s) {
    var m   = META[s.code] || { icon: '<circle cx="12" cy="12" r="9"/>', color: '#0E9F6B' };
    var cnt = (bySystem || []).find(function(b){ return b.code === s.code; });
    /* extract :PORT from hostname e.g. "127.0.0.1:4173" → ":4173" */
    var portMatch = (s.hostname || '').match(/:(\d+)$/);
    var portLabel = portMatch ? ':' + portMatch[1] : '';
    var formLabel = (typeof FORM_LABEL !== 'undefined' && FORM_LABEL[s.code]) || '—';
    return {
      code:      s.code,
      name:      s.name,
      category:  s.category,
      hostname:  s.hostname || s.code,
      portLabel: portLabel,
      formLabel: formLabel,
      n:         cnt ? (cnt.n || 0) : 0,
      icon:      m.icon,
      color:     m.color,
    };
  });

  var activePortal = filter ? enriched.find(function(p){ return p.code === filter; }) : null;
  var totalRecords = enriched.reduce(function(a, b){ return a + b.n; }, 0);
%>

<!-- PAGE HEADER -->
<div class="page-head">
  <div>
    <h1 class="page-title"><%= activePortal ? activePortal.name : 'Government Portals' %></h1>
    <p class="page-desc">
      <% if (activePortal) { %>
        Local demonstration replica — <strong><%= activePortal.category %></strong>.
        Records below were received by the ERP through
        <code style="font-family:var(--mono);font-size:12px;background:var(--surface-3);padding:1px 6px;border-radius:5px">POST /api/intake</code>.
      <% } else { %>
        Five local replica portals push records into the ERP through a single write-through API.
        Each card shows the portal's source-system code, documented form type and live record count.
      <% } %>
    </p>
  </div>
  <div class="page-actions">
    <% if (filter) { %>
      <a href="/portals" class="btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m15 18-6-6 6-6"/></svg>
        All portals
      </a>
      <a href="/intake?system=<%= filter %>" class="btn btn-primary">View all records &rarr;</a>
    <% } %>
  </div>
</div>

<!-- DEMO BANNER -->
<div style="background:var(--warning-bg);border:1px solid #E8D5A0;border-radius:var(--r-sm);padding:9px 14px;margin-bottom:20px;display:flex;align-items:center;gap:9px;font-size:12.5px;color:#7A5A1A">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="width:14px;height:14px;flex-shrink:0;color:#B67C24"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
  <span><strong>Unofficial local demonstration.</strong> These are local replicas only — not official government services. All data is synthetic.</span>
</div>

<% if (activePortal) { %>
  <!-- ══ SINGLE PORTAL VIEW ═════════════════════════════════════════════ -->

  <div class="card" style="margin-bottom:16px">
    <div style="display:flex;align-items:center;gap:18px;flex-wrap:wrap;padding:20px 22px">
      <div style="width:56px;height:56px;border-radius:16px;background:linear-gradient(135deg,var(--mint-100),var(--mint-200));display:grid;place-items:center;flex-shrink:0;box-shadow:var(--sh-sm)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" style="width:28px;height:28px;color:<%= activePortal.color %>"><%- activePortal.icon %></svg>
      </div>
      <div style="flex:1;min-width:0">
        <div style="font-size:21px;font-weight:800;letter-spacing:-.03em;color:var(--ink)"><%= activePortal.name %></div>
        <div style="font-size:13px;color:var(--text-2);margin-top:2px"><%= activePortal.category %></div>
        <div style="display:flex;align-items:center;gap:8px;margin-top:5px;flex-wrap:wrap">
          <code style="font-family:var(--mono);font-size:11px;background:var(--surface-3);border:1px solid var(--border);padding:2px 7px;border-radius:6px"><%= activePortal.portLabel %></code>
          <span style="font-size:12px;color:var(--text-3)"><%= activePortal.formLabel %></span>
          <span style="font-size:12px;color:var(--text-3)">·</span>
          <span style="font-family:var(--mono);font-size:11px;color:var(--text-3)"><%= activePortal.hostname %></span>
        </div>
      </div>
      <div style="text-align:right;flex-shrink:0">
        <div style="font-size:44px;font-weight:800;letter-spacing:-.05em;color:var(--ink);font-variant-numeric:tabular-nums;line-height:1"><%= activePortal.n %></div>
        <div style="font-size:12px;color:var(--text-3);margin-top:2px">records</div>
      </div>
    </div>
    <div style="border-top:1px solid var(--border);padding:10px 22px;display:flex;align-items:center;gap:10px;flex-wrap:wrap">
      <span class="pill pill-ok" style="font-size:11px">active replica</span>
      <code style="font-family:var(--mono);font-size:11px;color:var(--text-3)"><%= activePortal.code %></code>
      <div style="margin-left:auto;display:flex;gap:8px">
        <a href="/sync?system=<%= activePortal.code %>" class="btn btn-sm">Sync log</a>
        <a href="/intake?system=<%= activePortal.code %>" class="btn btn-sm">Records</a>
        <a href="http://<%= activePortal.hostname %>" target="_blank" rel="noopener" class="btn btn-sm btn-primary">
          Open replica
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="width:12px;height:12px"><path d="M14 4h6v6M20 4l-9 9"/><path d="M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5"/></svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Recent records for this portal -->
  <div class="card">
    <div class="card-head">
      <div>
        <div class="card-title">Recent records — <%= activePortal.name %></div>
        <div class="card-sub">Last 25 records received from this portal via <code style="font-family:var(--mono);font-size:11px">POST /api/intake</code>. Click a row for field details.</div>
      </div>
      <a href="/intake?system=<%= activePortal.code %>" class="btn btn-sm">View all &rarr;</a>
    </div>
    <% if (!recent || !recent.length) { %>
      <div class="empty-state">
        <div class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 13h4l2 3h4l2-3h4"/><path d="M5.5 5h13l1.5 8v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-4Z"/></svg></div>
        <div class="empty-title">No records from <%= activePortal.name %> yet</div>
        <div class="empty-hint">Records appear once the portal submits through the intake API.</div>
      </div>
    <% } else { %>
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr>
            <th data-sort>ERP Ref</th>
            <th data-sort>Form</th>
            <th data-sort>Portal Ref</th>
            <th data-sort>Citizen</th>
            <th data-sort>Fields</th>
            <th data-sort>Received</th>
          </tr></thead>
          <tbody>
            <% recent.forEach(function(r) { %>
              <% var fields = r.fields || []; %>
              <tr class="clickable" onclick="openDrawer('<%= r.intake_ref %>', `<div><div class='kv-list'>
                <div class='kv-row'><div class='kv-key'>ERP Ref</div><div class='kv-val'><code style='font-family:var(--mono);font-size:11.5px'><%= r.intake_ref %></code></div></div>
                <div class='kv-row'><div class='kv-key'>Source</div><div class='kv-val'><%= r.source_system %></div></div>
                <div class='kv-row'><div class='kv-key'>Form</div><div class='kv-val'><%= r.subject || r.source_form %></div></div>
                <div class='kv-row'><div class='kv-key'>Portal ref</div><div class='kv-val'><code style='font-family:var(--mono);font-size:11.5px'><%= r.source_reference %></code></div></div>
                <div class='kv-row'><div class='kv-key'>Citizen</div><div class='kv-val'><%= r.full_name || '—' %></div></div>
                <div class='kv-row'><div class='kv-key'>Received</div><div class='kv-val'><%= r.received_at %></div></div>
              </div></div>`)">
                <td><code class="mono-chip"><%= r.intake_ref %></code></td>
                <td><%= r.subject || r.source_form %></td>
                <td><code class="mono-chip"><%= r.source_reference %></code></td>
                <td><%= r.full_name || '—' %><% if (r.email) { %><br><span style="font-size:11.5px;color:var(--text-3)"><%= r.email %></span><% } %></td>
                <td><% if (fields.length) { %><span class="pill pill-neutral" style="font-size:11px"><%= fields.length %></span><% } else { %><span style="color:var(--text-4)">—</span><% } %></td>
                <td style="font-size:12.5px;color:var(--text-3);white-space:nowrap"><%= r.received_at %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

<% } else { %>
  <!-- ══ ALL PORTALS VIEW ════════════════════════════════════════════════ -->

  <!-- Portal cards — exact reference layout -->
  <div class="portal-grid" style="margin-bottom:20px">
    <% enriched.forEach(function(p) { %>
      <div class="portal-card">
        <!-- card head: icon + name + category -->
        <div class="portal-head">
          <div class="portal-icon" style="background:linear-gradient(135deg,var(--mint-100),var(--mint-200))">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" style="width:22px;height:22px;color:<%= p.color %>"><%- p.icon %></svg>
          </div>
          <div>
            <div class="portal-name"><%= p.name %></div>
            <div class="portal-category"><%= p.category %></div>
          </div>
        </div>

        <!-- port + form label row -->
        <div style="display:flex;align-items:center;gap:8px;margin:10px 0 4px;flex-wrap:wrap">
          <code style="font-family:var(--mono);font-size:11px;background:var(--surface-3);border:1px solid var(--border);padding:2px 7px;border-radius:6px;color:var(--text-2)"><%= p.portLabel %></code>
          <span style="font-size:12px;color:var(--text-3)"><%= p.formLabel %></span>
        </div>

        <!-- record count -->
        <div style="display:flex;align-items:baseline;gap:5px;margin:6px 0 2px">
          <span style="font-size:28px;font-weight:800;letter-spacing:-.04em;color:var(--ink);font-variant-numeric:tabular-nums;line-height:1"><%= p.n %></span>
          <span style="font-size:12px;color:var(--text-3)">records</span>
        </div>

        <!-- hostname -->
        <div class="portal-host" style="margin-bottom:12px"><%= p.hostname %></div>

        <!-- actions -->
        <div style="display:flex;gap:7px;margin-top:auto">
          <a href="/portals?system=<%= p.code %>" class="btn btn-sm" style="flex:1;justify-content:center">View</a>
          <a href="/intake?system=<%= p.code %>" class="btn btn-sm" style="flex:1;justify-content:center">Records</a>
          <a href="http://<%= p.hostname %>" target="_blank" rel="noopener" class="btn btn-sm btn-primary" style="flex:1;justify-content:center">
            Open replica
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="width:11px;height:11px"><path d="M14 4h6v6M20 4l-9 9"/><path d="M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5"/></svg>
          </a>
        </div>
      </div>
    <% }); %>
  </div>

  <!-- Records by portal bar chart -->
  <%
    var maxN = Math.max.apply(null, enriched.map(function(p){ return p.n; })) || 1;
  %>
  <div class="card">
    <div class="card-head">
      <div>
        <div class="card-title">Records by portal</div>
        <div class="card-sub">Total across all portals: <strong><%= totalRecords %></strong></div>
      </div>
      <span class="pill pill-mint"><%= systems.length %> portals</span>
    </div>
    <div class="card-body">
      <div class="bar-chart">
        <% enriched.forEach(function(p) { %>
          <div class="bar-row">
            <div class="bar-label" title="<%= p.name %>"><%= p.name %></div>
            <div class="bar-track">
              <div class="bar-fill" style="width:<%= Math.round((p.n/maxN)*100) %>%;background:<%= p.color %>"></div>
            </div>
            <div class="bar-val"><%= p.n %></div>
          </div>
        <% }); %>
      </div>
    </div>
  </div>
<% } %>

<%- include('layout-foot') %>
