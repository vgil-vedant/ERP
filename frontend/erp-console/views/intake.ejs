<%- include('layout-head') %>

<!-- PAGE HEADER -->
<div class="page-head">
  <div>
    <h1 class="page-title">
      Received Records<% if (system) { %> <span style="font-weight:500;color:var(--text-3);font-size:18px">&mdash; <%= system %></span><% } %>
    </h1>
    <p class="page-desc">
      Every row the ERP accepted through <code style="font-family:var(--mono);font-size:12px;background:var(--surface-3);padding:1px 5px;border-radius:5px">POST&nbsp;/api/intake</code>, newest first.
      Idempotent: a retry with the same <code style="font-family:var(--mono);font-size:12px">source_system&nbsp;+&nbsp;source_reference</code> returns 200 and adds no row.
    </p>
  </div>
  <div class="page-actions">
    <button class="btn" type="button" onclick="exportTableCSV('erp-records.csv')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0 4-4m-4 4-4-4"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
      Export CSV
    </button>
  </div>
</div>

<!-- RECORDS CARD -->
<div class="card">
  <div class="card-head">
    <div>
      <div class="card-title">Intake rows</div>
      <div class="card-sub"><%= rows.length %> record<%= rows.length === 1 ? '' : 's' %><% if (system) { %> from <strong><%= system %></strong><% } %></div>
    </div>
    <span class="pill pill-mint">GET /api/intake</span>
  </div>

  <!-- Toolbar: portal filter + search -->
  <div class="tbl-toolbar">
    <div class="filter-chips">
      <a href="/intake" class="filter-chip<%= !system ? ' is-active' : '' %>">All</a>
      <% systems.forEach(function (s) { %>
        <a href="/intake?system=<%= s.code %>" class="filter-chip<%= system === s.code ? ' is-active' : '' %>"><%= s.code %></a>
      <% }); %>
    </div>
    <div class="tbl-search-wrap">
      <div class="tbl-search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.2-3.2"/></svg>
        <input id="tableSearch" type="search" placeholder="Search…" autocomplete="off" aria-label="Search records">
      </div>
    </div>
  </div>

  <% if (!rows.length) { %>
    <div class="empty-state">
      <div class="empty-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7a2 2 0 0 1 2-2h9l5 5v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z"/><path d="M14 5v5h5M8 14h8M8 17h5"/></svg>
      </div>
      <div class="empty-title">No records<% if (system) { %> from <%= system %><% } %> yet</div>
      <div class="empty-hint"><% if (system) { %>Try a different portal filter or wait for a submission.<% } else { %>Submit a form on any portal and it will appear here.<% } %></div>
    </div>
  <% } else { %>
    <div class="tbl-wrap">
      <table class="tbl" id="mainTable">
        <thead>
          <tr>
            <th data-sort>ERP Ref</th>
            <th data-sort>Source</th>
            <th data-sort>Form</th>
            <th data-sort>Portal Ref</th>
            <th data-sort>Citizen</th>
            <th data-sort>Fields</th>
            <th data-sort>Received</th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(function (r) { %>
            <%
              var fields = r.fields || [];
              var drawerHtml = '<div><div class="drawer-section-title">Intake record</div><div class="kv-list">'
                + '<div class="kv-row"><div class="kv-key">ERP Ref</div><div class="kv-val"><code style="font-family:var(--mono);font-size:11.5px">' + (r.intake_ref||'—') + '</code></div></div>'
                + '<div class="kv-row"><div class="kv-key">Source system</div><div class="kv-val"><span class="sys-chip">' + (r.source_system||'—') + '</span></div></div>'
                + '<div class="kv-row"><div class="kv-key">Form</div><div class="kv-val">' + (r.subject || r.source_form||'—') + '</div></div>'
                + (r.source_route ? '<div class="kv-row"><div class="kv-key">Route</div><div class="kv-val"><code style="font-family:var(--mono);font-size:11px">' + r.source_route + '</code></div></div>' : '')
                + '<div class="kv-row"><div class="kv-key">Portal ref</div><div class="kv-val"><code style="font-family:var(--mono);font-size:11.5px">' + (r.source_reference||'—') + '</code></div></div>'
                + '<div class="kv-row"><div class="kv-key">Citizen</div><div class="kv-val">' + (r.full_name||'—') + (r.email ? '<br><span style="font-size:11.5px;color:var(--text-3)">' + r.email + '</span>' : '') + '</div></div>'
                + '<div class="kv-row"><div class="kv-key">Received at</div><div class="kv-val">' + (r.received_at||'—') + '</div></div>'
                + '</div></div>';
              if (fields.length) {
                drawerHtml += '<div><div class="drawer-section-title">Field values (' + fields.length + ')</div><div class="kv-list">';
                fields.forEach(function(f) {
                  drawerHtml += '<div class="kv-row"><div class="kv-key">' + (f.label||f.name) + '</div><div class="kv-val">' + (f.value == null ? '—' : String(f.value)) + '</div></div>';
                });
                drawerHtml += '</div></div>';
              }
            %>
            <tr class="clickable" onclick="openDrawer('<%= r.intake_ref %>', '<%= drawerHtml.replace(/'/g, "\\'").replace(/\n/g, '').replace(/\r/g, '') %>')">
              <td><code class="mono-chip"><%= r.intake_ref %></code><br><span style="font-size:11px;color:var(--text-3);font-family:var(--mono)"><%= r.received_at %></span></td>
              <td><span class="sys-chip"><%= r.source_system %></span></td>
              <td>
                <span style="font-weight:500"><%= r.subject || r.source_form %></span>
                <% if (r.source_route) { %><br><code style="font-family:var(--mono);font-size:10.5px;color:var(--text-3)"><%= r.source_route %></code><% } %>
              </td>
              <td><code class="mono-chip"><%= r.source_reference %></code></td>
              <td>
                <% if (r.full_name) { %><strong><%= r.full_name %></strong><% } else { %><span style="color:var(--text-4)">—</span><% } %>
                <% if (r.email) { %><br><span style="font-size:11.5px;color:var(--text-3)"><%= r.email %></span><% } %>
              </td>
              <td>
                <% if (!fields.length) { %><span style="color:var(--text-4)">—</span><% } else { %>
                  <span class="pill pill-neutral" style="font-size:11px"><%= fields.length %></span>
                <% } %>
              </td>
              <td style="color:var(--text-3);font-size:12.5px;white-space:nowrap"><%= r.received_at %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <!-- Pager -->
    <div class="pager">
      <span class="pager-info" id="pagerInfo"></span>
      <button class="pager-btn" id="pagerPrev" type="button" onclick="goPage(-1)" aria-label="Previous page">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <button class="pager-btn" id="pagerNext" type="button" onclick="goPage(1)" aria-label="Next page">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  <% } %>

  <div style="padding:10px 20px;border-top:1px solid var(--border);font-size:11.5px;line-height:1.7;color:var(--text-3);overflow-wrap:anywhere">
    <svg style="vertical-align:-2px;margin-right:6px" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v4h1"/></svg>
    Only <code style="font-family:var(--mono);font-size:10.5px">source_system</code> + <code style="font-family:var(--mono);font-size:10.5px">source_reference</code> pairs documented in the project appear; others are logged as illustrative.
  </div>
</div>

<script>
(function () {
  var searchInput = document.getElementById('tableSearch');
  var table = document.getElementById('mainTable');
  if (!searchInput || !table) return;
  searchInput.addEventListener('input', function () {
    var q = searchInput.value.toLowerCase().trim();
    var rows = table.querySelectorAll('tbody tr');
    rows.forEach(function (tr) {
      tr.style.display = !q || tr.textContent.toLowerCase().includes(q) ? '' : 'none';
    });
    if (typeof updatePager === 'function') updatePager();
  });
})();
</script>

<%- include('layout-foot') %>
