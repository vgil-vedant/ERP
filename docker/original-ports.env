# Publishes the Docker stack on the ports the original servers used (no secrets here).
# Use it with:  docker compose --env-file docker/original-ports.env up -d
# The hub and the five portals listen on this machine's network address.
# The ERP console stays on 127.0.0.1 and PostgreSQL stays on 127.0.0.1:7432.
ERP_BIND_ADDR=10.166.170.105
ERP_HOST_PORT_HUB=4100
ERP_HOST_PORT_EPRISONS=4173
ERP_HOST_PORT_CCTNS=4175
ERP_HOST_PORT_EFORENSICS=4176
ERP_HOST_PORT_AADHAAR=4177
ERP_HOST_PORT_ECOURTS=4178
ERP_HOST_PORT_ERP=4200
