# Copy to .env and fill in. .env is never committed or shared.
PGHOST=127.0.0.1
PGPORT=7432
PGUSER=ams
PGDATABASE=demo_replica
PGPASSWORD=

# Docker (compose.yaml): optional host-port overrides, defaults shown
# ERP_HOST_PORT_ERP=7200
# ERP_HOST_PORT_HUB=7100
# ERP_HOST_PORT_EPRISONS=7173
# ERP_HOST_PORT_CCTNS=7175
# ERP_HOST_PORT_EFORENSICS=7176
# ERP_HOST_PORT_AADHAAR=7177
# ERP_HOST_PORT_ECOURTS=7178
# ERP_HOST_PORT_POSTGRES=7432
# ERP_IMAGE_TAG=1.0.0
# ERP_BIND_ADDR=127.0.0.1   # address the hub and portals listen on; set to this machine's LAN IP to share them

# Secrets (backend/shared/security.js). None has a built-in value. In Docker, `bash docker/make-secrets.sh`
# creates them as secret files and compose.yaml passes them as NAME_FILE. Outside Docker, set them here
# (each also accepts NAME_FILE=/path) or leave them out in development: random ones are kept in
# database/.dev-secrets/.
# INTEGRATION_SECRET=       signs the departments' deliveries to the ERP
# ERP_API_TOKEN=            the platform's token for the ERP API
# LOOKUP_PEPPER=            key of the ERP's identifier hashes; changing it makes existing hashes unmatchable
# UIDAI_TOKEN_KEY=          key of the UIDAI agency tokens
# HUB_ADMIN_USER=admin
# HUB_ADMIN_PASSWORD_HASH=  scrypt$<salt hex>$<hash hex>  (or HUB_ADMIN_PASSWORD=, at least 10 characters)
# OFFICE_PASSWORD=          officers of all five offices, at least 10 characters (or OFFICE_PASSWORD_CCTNS= ...)
